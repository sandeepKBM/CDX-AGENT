#!/usr/bin/env bash
set -euo pipefail

SELF_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
USER_ROOT="/common/users/ss5772"
ACCOUNT_HOME="/common/home/ss5772"
TOOLS_ROOT="$USER_ROOT/codex_tools"
TOKEN_TOOLS_ROOT="$TOOLS_ROOT/token_tools"
HOOKS_ROOT="$TOOLS_ROOT/hooks"
LEGACY_WRAPPER="$USER_ROOT/bin/cdx-danger-auto"
BASE_AGENTS_TEMPLATE="$TOOLS_ROOT/base/AGENTS.md"
REPO_AGENTS_TEMPLATE="$TOOLS_ROOT/templates/repo.AGENTS.md"
REPO_GRAPH_ROOT="$TOOLS_ROOT/repo_graph_agent"
REPO_GRAPH_PYTHONPATH="$REPO_GRAPH_ROOT"
SITE_PTH="$ACCOUNT_HOME/.local/lib/python3.12/site-packages/codex_tools_repo_graph_agent.pth"
# CDX-AGENT Python package (the revamp: safety-hardened runtime/session/skills/hooks
# provisioning, plus Claude Code launch support). Same PYTHONPATH-injection pattern as
# REPO_GRAPH_PYTHONPATH above, so no pip install is required for bash to delegate to it.
CDX_AGENT_PYTHONPATH="${CDX_AGENT_PYTHONPATH:-$ACCOUNT_HOME/CDX-AGENT/src}"
DISABLED_MCP_FRAGMENT="$TOOLS_ROOT/base/mcp.repo_graph.example.toml.disabled"

MODE="launch"
ACCESS_MODE="full"
# Default engine for a bare `cdx-agent` invocation. Kept in sync with
# cdx_agent.launch.DEFAULT_ENGINE in the Python package (CDX-AGENT/src) --
# that's the single other place this default lives. Override per-invocation
# with --claude/--codex, or edit both this line and DEFAULT_ENGINE to change
# the default itself.
ENGINE="claude"
SECONDARY=0
TOKEN_SAVER=0
YES=0
DRY_RUN=0
SEEN_SEPARATOR=0
CANCEL_ACTIVE=0
NO_CANCEL_ACTIVE=0
TAKEOVER=0
DRAIN_SECONDS=0
INSTALL_TARGET="auto"
TARGET_LOG_FILE=""
CURRENT_LOGDIR=""
COMPRESS_COMMAND=()
MODULE_ARGS=()   # rest of argv for --offload/--notify/--move-verify/--gpu-lock/--brief (cdx_agent.<module>)
TARGET_REPO=""
FORCE_HOME_SCAN=0
PASSTHROUGH=()

if [[ "${CDX_DRY_RUN:-0}" == "1" ]]; then
  DRY_RUN=1
fi

timestamp() {
  date +"%Y%m%d_%H%M%S"
}

hostname_short() {
  hostname -s
}

have_cmd() {
  command -v "$1" >/dev/null 2>&1
}

current_dir() {
  pwd -P
}

cdx_is_dry_run() {
  [[ "${CDX_DRY_RUN:-0}" == "1" || "$DRY_RUN" -eq 1 ]]
}

is_git_repo() {
  git rev-parse --is-inside-work-tree >/dev/null 2>&1
}

repo_root() {
  if is_git_repo; then
    git rev-parse --show-toplevel
  else
    pwd -P
  fi
}

looks_like_project_dir() {
  local dir
  dir="$(readlink -f "$1")"
  [[ -f "$dir/pyproject.toml" ]] || \
  [[ -f "$dir/setup.py" ]] || \
  [[ -f "$dir/setup.cfg" ]] || \
  [[ -f "$dir/requirements.txt" ]] || \
  [[ -f "$dir/package.json" ]] || \
  [[ -f "$dir/Cargo.toml" ]] || \
  [[ -f "$dir/AGENTS.md" ]]
}

is_home_like_dir() {
  local dir home_dir
  dir="$(readlink -f "$1")"
  home_dir="$(readlink -f "${HOME:-$USER_ROOT}")"
  [[ "$dir" == "$USER_ROOT" ]] || [[ "$dir" == "$ACCOUNT_HOME" ]] || [[ "$dir" == "$home_dir" ]]
}

guarded_graph_target_dir() {
  local base target git_target
  if [[ -n "$TARGET_REPO" ]]; then
    base="$(readlink -f "$TARGET_REPO")"
  else
    base="$(current_dir)"
  fi
  if [[ ! -d "$base" ]]; then
    echo "Graph target is not a directory: $base" >&2
    exit 1
  fi
  target="$(readlink -f "$base")"
  if is_home_like_dir "$target" && [[ "$FORCE_HOME_SCAN" -ne 1 ]]; then
    echo "You are in your home directory. Refusing to graph-scan the whole home tree. cd into a repo first, or pass --repo <path> / --force-home-scan." >&2
    exit 1
  fi
  git_target="$(git -C "$base" rev-parse --show-toplevel 2>/dev/null || true)"
  if [[ -n "$git_target" ]]; then
    printf '%s' "$(readlink -f "$git_target")"
    return 0
  fi
  if looks_like_project_dir "$target"; then
    printf '%s' "$target"
    return 0
  fi
  echo "Current directory does not look like a repo or project. cd into a repo first, or pass --repo <path>." >&2
  exit 1
}

repo_name() {
  basename "$(repo_root)"
}

repo_slug() {
  local repo hash base
  repo="$(repo_root)"
  base="$(basename "$repo" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9._-]/_/g')"
  hash="$(printf '%s' "$repo" | sha1sum | awk '{print substr($1,1,10)}')"
  printf '%s__%s' "$base" "$hash"
}

runtime_codex_home() {
  # Fix (A1, matches cdx_agent.runtime.runtime_home): fold engine + access
  # mode into the path itself, so full/safe and codex/claude never share a
  # runtime directory (config.toml/auth.json/lock/skills) for the same repo.
  # Previously this omitted both, and current_codex_home()'s "full" vs.
  # non-"full" branches both called this exact same function -- a dead-code
  # bug that meant --safe silently inherited full-access state.
  local repo_slug_value host
  host="$(hostname_short)"
  repo_slug_value="$(repo_slug)"
  printf '%s/codex_runtime/%s/%s/%s/%s' "$USER_ROOT" "$host" "$ENGINE" "$ACCESS_MODE" "$repo_slug_value"
}

current_codex_home() {
  runtime_codex_home
}

ensure_tools_layout() {
  mkdir -p \
    "$TOOLS_ROOT/base" \
    "$TOOLS_ROOT/hooks" \
    "$TOOLS_ROOT/skills" \
    "$TOOLS_ROOT/skills_approved" \
    "$TOOLS_ROOT/skills_custom" \
    "$TOOLS_ROOT/skills_quarantine" \
    "$TOOLS_ROOT/subagent_prompts" \
    "$TOOLS_ROOT/repo_graph_agent/repo_graph_agent" \
    "$TOKEN_TOOLS_ROOT"
  if [[ ! -f "$DISABLED_MCP_FRAGMENT" ]]; then
    cat > "$DISABLED_MCP_FRAGMENT" <<'EOF'
# Optional Codex MCP fragment for the local repo_graph_agent.
# Keep this disabled unless you explicitly want to wire MCP separately.
#
# Example only:
# [mcp_servers.repo_graph_agent]
# command = "/usr/bin/python3"
# args = ["-m", "repo_graph_agent", "build"]
EOF
  fi
}

backup_path() {
  local path="$1"
  if [[ -e "$path" || -L "$path" ]]; then
    local backup="${path}.bak.$(timestamp)"
    cp -a "$path" "$backup"
    printf '%s' "$backup"
  fi
}

confirm_or_die() {
  local prompt="$1"
  if [[ "$YES" -eq 1 ]]; then
    return 0
  fi
  if [[ ! -t 0 ]]; then
    echo "Refusing to modify files without confirmation in a non-interactive shell."
    exit 1
  fi
  read -r -p "$prompt [y/N] " reply
  if [[ ! "$reply" =~ ^[Yy]$ ]]; then
    echo "Cancelled."
    exit 1
  fi
}

ensure_repo_graph_pythonpath() {
  local expected="$REPO_GRAPH_PYTHONPATH"
  mkdir -p "$(dirname "$SITE_PTH")"
  if [[ -f "$SITE_PTH" ]]; then
    local current
    current="$(tr -d '\r' < "$SITE_PTH")"
    if [[ "$current" == "$expected" ]]; then
      return 0
    fi
    backup_path "$SITE_PTH" >/dev/null || true
  fi
  printf '%s\n' "$expected" > "$SITE_PTH"
}

launch_log_dir() {
  local stamp repo
  stamp="$(timestamp)"
  repo="$(repo_name | sed 's/[^A-Za-z0-9._-]/_/g')"
  printf '%s/codex_logs/%s_%s' "$USER_ROOT" "$stamp" "$repo"
}

ensure_session_log_dir() {
  if [[ -n "$CURRENT_LOGDIR" ]]; then
    printf '%s' "$CURRENT_LOGDIR"
    return 0
  fi
  CURRENT_LOGDIR="$(launch_log_dir)"
  mkdir -p "$CURRENT_LOGDIR"
  printf '%s' "$CURRENT_LOGDIR"
}

sanitize_file_stem() {
  local raw="${1:-artifact}"
  printf '%s' "$raw" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9._-]/_/g'
}

raw_output_path_for_session() {
  local stem="${1:-command}"
  local logdir
  logdir="$(ensure_session_log_dir)"
  mkdir -p "$logdir/raw_outputs"
  printf '%s/raw_outputs/%s_%s.txt' "$logdir" "$(timestamp)" "$(sanitize_file_stem "$stem")"
}

compressed_output_path_for_session() {
  local stem="${1:-command}"
  local logdir
  logdir="$(ensure_session_log_dir)"
  mkdir -p "$logdir/compressed_outputs"
  printf '%s/compressed_outputs/%s_%s.txt' "$logdir" "$(timestamp)" "$(sanitize_file_stem "$stem")"
}

write_token_saver_marker() {
  local logdir="$1"
  mkdir -p "$logdir"
  printf 'token_saver=%s\n' "$TOKEN_SAVER" > "$logdir/token_saver_enabled.txt"
  mkdir -p "$logdir/raw_outputs" "$logdir/compressed_outputs"
}

token_tool_script() {
  printf '%s/%s' "$TOKEN_TOOLS_ROOT" "$1"
}

record_usage_snapshot() {
  local logdir="$1"
  local phase="$2"
  if have_cmd ccusage; then
    ccusage codex daily > "$logdir/usage_snapshot_${phase}.txt" 2>&1 || true
  fi
}

record_launch_metadata() {
  local logdir runtime repo sandbox approval
  logdir="$1"
  runtime="$(current_codex_home)"
  repo="$(repo_root)"
  sandbox="$2"
  approval="$3"
  mkdir -p "$logdir"
  write_token_saver_marker "$logdir"
  {
    echo "repo=$repo"
    echo "repo_name=$(repo_name)"
    echo "codex_home=$runtime"
    echo "sandbox=$sandbox"
    echo "approval=$approval"
    echo "approvals_reviewer=auto_review"
    echo "token_saver=$TOKEN_SAVER"
    echo "legacy_wrapper=$LEGACY_WRAPPER"
    echo "wrapper=$SELF_PATH"
  } > "$logdir/launch_meta.txt"
  if [[ -f "$runtime/AGENTS.md" ]]; then
    cp -p "$runtime/AGENTS.md" "$logdir/AGENTS.runtime.md"
  fi
  if [[ -f "$repo/.codex_graph/context_pack.md" ]]; then
    cp -p "$repo/.codex_graph/context_pack.md" "$logdir/context_pack.md"
  fi
  if [[ -f "$repo/.codex_graph/workspace_context_pack.md" ]]; then
    cp -p "$repo/.codex_graph/workspace_context_pack.md" "$logdir/workspace_context_pack.md"
  fi
}

write_launch_command() {
  local logdir="$1"
  shift
  printf '%q ' "$@" > "$logdir/launch_command.sh"
  printf '\n' >> "$logdir/launch_command.sh"
}

finalize_launch_log() {
  local logdir repo
  logdir="$1"
  repo="$(repo_root)"
  if git -C "$repo" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    git -C "$repo" status --short > "$logdir/git_status.short" || true
    git -C "$repo" diff --stat > "$logdir/git_diff.stat" || true
  fi
}

graph_preflight() {
  local repo graph workspace_graph
  repo="$(repo_root)"
  graph="$repo/.codex_graph/context_pack.md"
  workspace_graph="$repo/.codex_graph/workspace_context_pack.md"
  echo "PREFLIGHT repo=$repo"
  if [[ -f "$repo/AGENTS.md" ]]; then
    echo "AGENTS=present"
  else
    echo "AGENTS=missing"
  fi
  if [[ -f "$graph" ]]; then
    echo "GRAPH=present"
  else
    echo "GRAPH=missing (run: cdx-agent --graph)"
  fi
  if [[ -f "$workspace_graph" ]]; then
    echo "WORKSPACE_GRAPH=present"
  else
    echo "WORKSPACE_GRAPH=missing (run: cdx-agent --workspace-graph)"
  fi
}

run_repo_graph_build() {
  local repo="$1"
  shift || true
  PYTHONPATH="$REPO_GRAPH_PYTHONPATH${PYTHONPATH:+:$PYTHONPATH}" python3 -m repo_graph_agent build --repo "$repo" "$@"
}

run_repo_graph_detect_deps() {
  local repo="$1"
  PYTHONPATH="$REPO_GRAPH_PYTHONPATH${PYTHONPATH:+:$PYTHONPATH}" python3 -m repo_graph_agent detect-deps --repo "$repo"
}

run_repo_graph_init_workspace() {
  local repo="$1"
  if [[ "$YES" -eq 0 ]]; then
    confirm_or_die "Create workspace.yaml in $repo?"
  fi
  PYTHONPATH="$REPO_GRAPH_PYTHONPATH${PYTHONPATH:+:$PYTHONPATH}" python3 -m repo_graph_agent init-workspace --repo "$repo" --yes
}

run_repo_graph_workspace_graph() {
  local repo="$1"
  PYTHONPATH="$REPO_GRAPH_PYTHONPATH${PYTHONPATH:+:$PYTHONPATH}" python3 -m repo_graph_agent workspace-graph --repo "$repo"
}

run_repo_graph_workspace_doctor() {
  local repo="$1"
  PYTHONPATH="$REPO_GRAPH_PYTHONPATH${PYTHONPATH:+:$PYTHONPATH}" python3 -m repo_graph_agent workspace-doctor --repo "$repo"
}

default_repo_agents_content() {
  local repo_name_value="$1"
  sed "s/__REPO_NAME__/$repo_name_value/g" "$REPO_AGENTS_TEMPLATE"
}

write_repo_agents() {
  local repo target repo_base
  repo="$1"
  target="$repo/AGENTS.md"
  repo_base="$(basename "$repo")"
  if [[ -e "$target" ]]; then
    if grep -q "cdx-agent managed guidance" "$target"; then
      return 0
    fi
    backup_path "$target" >/dev/null || true
    {
      cat "$target"
      echo
      default_repo_agents_content "$repo_base"
    } > "${target}.tmp"
    mv "${target}.tmp" "$target"
    return 0
  fi
  default_repo_agents_content "$repo_base" > "$target"
}

install_repo_hooks() {
  # One hook writer: the Python package (all six hooks, codex layout under <repo>/.codex).
  cdx_agent_py install-hooks --repo "$1" --engine codex
}

tool_install_command() {
  local tool="$1"
  case "$tool" in
    rtk)
      if have_cmd cargo; then
        printf 'cargo install --root %q --git https://github.com/rtk-ai/rtk' "$ACCOUNT_HOME/.local"
      fi
      ;;
    ccusage)
      if have_cmd npm; then
        printf 'npm install --prefix %q ccusage' "$ACCOUNT_HOME/.local"
      elif have_cmd bun; then
        printf 'bun install -g ccusage'
      elif have_cmd pnpm; then
        printf 'pnpm add -g ccusage'
      fi
      ;;
    tokscale)
      if have_cmd npm; then
        printf 'npm install --prefix %q tokscale' "$ACCOUNT_HOME/.local"
      elif have_cmd bun; then
        printf 'bun install -g tokscale'
      elif have_cmd pnpm; then
        printf 'pnpm add -g tokscale'
      fi
      ;;
  esac
}

install_one_token_tool() {
  local tool="$1"
  local cmd
  if have_cmd "$tool"; then
    echo "$tool already installed at $(command -v "$tool")"
    return 0
  fi
  cmd="$(tool_install_command "$tool")"
  if [[ -z "$cmd" ]]; then
    echo "$tool install skipped: no supported package manager detected."
    case "$tool" in
      rtk) echo "  manual install: git clone https://github.com/rtk-ai/rtk, read its install.sh, then build with cargo (cdx-agent never runs curl | sh)." ;;
      *) echo "  manual install: install node/npm (or bun/pnpm), then run: npm install --prefix ~/.local $tool" ;;
    esac
    return 0
  fi
  echo "install_command[$tool]=$cmd"
  if [[ "$YES" -eq 0 ]]; then
    confirm_or_die "Install $tool using the command above?"
  fi
  bash -lc "$cmd"
}

install_token_tools() {
  ensure_tools_layout
  echo "rtk_status=$(have_cmd rtk && echo installed || echo missing)"
  install_one_token_tool rtk
  echo
  echo "ccusage_status=$(have_cmd ccusage && echo installed || echo missing)"
  install_one_token_tool ccusage
  echo
  echo "tokscale_status=$(have_cmd tokscale && echo installed || echo missing)"
  install_one_token_tool tokscale
}

should_use_rtk_for_command() {
  local first="${1:-}"
  case "$first" in
    git|rg|grep|ls|tree|pytest|cargo|npm|pnpm|bun|python|python3)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

run_with_rtk_if_available() {
  if have_cmd rtk && should_use_rtk_for_command "$@"; then
    rtk "$@"
  else
    "$@"
  fi
}

run_and_capture_raw() {
  local raw_file="$1"
  shift
  "$@" >"$raw_file" 2>&1
}

small_targeted_read_should_stay_raw() {
  local raw_file="$1"
  shift
  local line_count first
  line_count="$(wc -l < "$raw_file" 2>/dev/null || echo 0)"
  first="${1:-}"
  if (( line_count > 200 )); then
    return 1
  fi
  case "$first" in
    sed|cat|head|tail)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

summarize_raw_output() {
  local raw_file="$1"
  local summary_file="$2"
  local command_text="$3"
  local exit_code="$4"
  shift 4
  if small_targeted_read_should_stay_raw "$raw_file" "$@"; then
    cp -p "$raw_file" "$summary_file"
    return 0
  fi
  python3 "$(token_tool_script summarize_output.py)" \
    --input "$raw_file" \
    --command "$command_text" \
    --exit-code "$exit_code" \
    > "$summary_file"
}

run_context_budget() {
  local repo logdir report
  repo="$(guarded_graph_target_dir)"
  logdir="$(ensure_session_log_dir)"
  report="$logdir/context_budget.txt"
  python3 "$(token_tool_script context_budget.py)" --repo "$repo" | tee "$report"
  echo "context_budget_log=$report"
}

run_summarize_log() {
  local log_file summary_file logdir
  if [[ -z "$TARGET_LOG_FILE" ]]; then
    echo "Missing log file for --summarize-log"
    exit 1
  fi
  log_file="$(readlink -f "$TARGET_LOG_FILE")"
  if [[ ! -f "$log_file" ]]; then
    echo "Log file not found: $TARGET_LOG_FILE"
    exit 1
  fi
  logdir="$(ensure_session_log_dir)"
  summary_file="$(compressed_output_path_for_session "$(basename "$log_file")")"
  python3 "$(token_tool_script summarize_log.py)" --input "$log_file" | tee "$summary_file"
  echo "summary_output=$summary_file"
}

run_compress_output() {
  local raw_file summary_file command_text exit_code logdir
  if [[ "${#COMPRESS_COMMAND[@]}" -eq 0 ]]; then
    echo "Missing command for --compress-output"
    exit 1
  fi
  logdir="$(ensure_session_log_dir)"
  raw_file="$(raw_output_path_for_session "${COMPRESS_COMMAND[0]}")"
  summary_file="$(compressed_output_path_for_session "${COMPRESS_COMMAND[0]}")"
  printf -v command_text '%q ' "${COMPRESS_COMMAND[@]}"
  if run_and_capture_raw "$raw_file" run_with_rtk_if_available "${COMPRESS_COMMAND[@]}"; then
    exit_code=0
  else
    exit_code=$?
  fi
  summarize_raw_output "$raw_file" "$summary_file" "$command_text" "$exit_code" "${COMPRESS_COMMAND[@]}"
  cat "$summary_file"
  echo
  echo "raw_output=$raw_file"
  echo "summary_output=$summary_file"
  echo "exit_code=$exit_code"
  if [[ "$exit_code" -ne 0 ]]; then
    echo "Rerun the command directly if needed: ${command_text}"
  fi
  return "$exit_code"
}

review_repo() {
  local repo logdir files dangerous=0
  repo="$(repo_root)"
  logdir="$(launch_log_dir)"
  mkdir -p "$logdir"
  echo "repo=$repo"
  if ! git -C "$repo" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    echo "Not a git repo."
    return 0
  fi
  echo
  echo "git diff --stat"
  git -C "$repo" diff --stat || true
  echo
  echo "changed files"
  git -C "$repo" status --short || true
  echo
  echo "dangerous changes"
  while IFS= read -r file; do
    [[ -n "$file" ]] || continue
    if [[ "$file" =~ (^|/)(checkpoints?|datasets?|data|logs|wandb|outputs)(/|$) ]] || [[ "$file" =~ \.(pt|pth|ckpt|safetensors|bin|h5|parquet)$ ]]; then
      echo "WARN data/artifact path: $file"
      dangerous=1
    elif [[ "$file" =~ (^|/)(policies|runtime|env|training)(/|$) ]]; then
      echo "WARN core runtime/training path: $file"
      dangerous=1
    fi
  done < <(git -C "$repo" diff --name-only && git -C "$repo" diff --cached --name-only)
  if [[ "$dangerous" -eq 0 ]]; then
    echo "No obvious dangerous changes found."
  fi
  git -C "$repo" diff --stat > "$logdir/git_diff.stat" || true
  git -C "$repo" status --short > "$logdir/git_status.short" || true
  echo "review_log_dir=$logdir"
}

# Run a cdx_agent Python CLI subcommand, e.g. `cdx_agent_py session-doctor --repo .`
cdx_agent_py() {
  PYTHONPATH="$CDX_AGENT_PYTHONPATH" python3 -m cdx_agent "$@"
}

# Run one standalone cdx_agent module, e.g. `cdx_agent_mod offload --help`
# (offload, notify, move_verify, gpu_lock, brief; each has its own --help).
cdx_agent_mod() {
  local mod="$1"
  shift
  PYTHONPATH="$CDX_AGENT_PYTHONPATH" python3 -m "cdx_agent.$mod" "$@"
}

launch_codex() {
  # Delegates to the cdx_agent Python package for everything that matters
  # safety-wise: runtime provisioning (isolated per engine+access-mode, A1
  # fix), session locking/cancellation (PID-verified, A3 fix), skills linking
  # (enforced audit gate, A4 fix), and hooks/doc generation (A6/D2/D3 fixes).
  # Bash keeps only the session-log-directory bookkeeping it already owned
  # (codex_logs/<ts>_<repo>/launch_meta.txt, usage snapshots, git status
  # capture) until that gets ported too. See docs/migration.md in the
  # CDX-AGENT repo for the full parity tracking.
  local repo access_flag logdir status
  repo="$(repo_root)"
  access_flag="--safe"
  [[ "$ACCESS_MODE" == "full" ]] && access_flag="--full"

  graph_preflight

  logdir="$(ensure_session_log_dir)"
  record_launch_metadata "$logdir" \
    "$([[ "$ACCESS_MODE" == "full" ]] && printf 'danger-full-access' || printf 'workspace-write')" \
    "on-request"
  record_usage_snapshot "$logdir" before

  local -a python_args=(launch --repo "$repo" --engine "$ENGINE" "$access_flag")
  [[ "$DRY_RUN" -eq 1 ]] && python_args+=(--dry-run)
  [[ "$TOKEN_SAVER" -eq 1 ]] && python_args+=(--token-saver)
  if [[ "$TAKEOVER" -eq 1 ]]; then
    python_args+=(--takeover)
  elif [[ "$CANCEL_ACTIVE" -eq 1 ]]; then
    python_args+=(--cancel-active)
  elif [[ "$SECONDARY" -eq 1 ]]; then
    python_args+=(--secondary)
  fi
  [[ "$DRAIN_SECONDS" != "0" ]] && python_args+=(--drain "$DRAIN_SECONDS")

  write_launch_command "$logdir" python3 -m cdx_agent "${python_args[@]}" -- "${PASSTHROUGH[@]}"

  echo "MODE=$ACCESS_MODE"
  echo "ENGINE=$ENGINE"
  echo "REPO=$repo"
  echo "LOGDIR=$logdir"
  echo

  set +e
  cdx_agent_py "${python_args[@]}" -- "${PASSTHROUGH[@]}"
  status=$?
  set -e
  record_usage_snapshot "$logdir" after
  finalize_launch_log "$logdir"
  return "$status"
}

run_init_repo() {
  local repo
  repo="$(repo_root)"
  confirm_or_die "Initialize repo-local Codex files in $repo?"
  mkdir -p "$repo/.codex"
  write_repo_agents "$repo"
  install_repo_hooks "$repo"
  run_repo_graph_build "$repo"
  echo "Initialized repo Codex scaffolding in $repo"
}

run_graph_only() {
  local repo
  repo="$(guarded_graph_target_dir)"
  run_repo_graph_build "$repo"
}

print_usage() {
  cat <<'EOF'
Usage:
  cdx-agent [options] [--] [engine args...]

Modes:
  --session-doctor      Diagnose active/stale session state for the
                        current repo without killing anything.
  --validate-skills     Validate discovered SKILL.md files across user, runtime,
                        repo-local, and managed skill roots.
  --skills-list         List discovered skills with roots, names, and descriptions.
  --skills-audit        Scan discovered skills for risky instructions and commands.
  --init-tools          Create or verify the local Codex tools layout.
  --init-repo           Initialize repo-local Codex scaffolding.
  --init-workspace      Create workspace.yaml through repo_graph_agent.
  --detect-deps         Run repo dependency detection for the target repo.
  --graph               Build .codex_graph/context_pack.md for the target repo.
  --workspace-graph     Build the workspace-level graph pack.
  --workspace-doctor    Inspect workspace graph/config status.
  --review              Show git diff/status plus risky-path warnings.
  --install-token-tools Install rtk, ccusage, and tokscale via a detected package
                        manager (no curl | sh; prints a manual hint otherwise).
  --install-hooks       Install repo hooks (claude: .claude/settings.json; codex: .codex/hooks.json).
  --context-budget      Print a token/context budget report for the repo.
  --compress-output     Run the remaining argv as a command, capture it,
                        and summarize the output.
  --summarize-log FILE  Summarize an existing log file.

Helpers (each consumes the rest of argv; `cdx-agent --<helper> --help` for details):
  --offload [--repo DIR] [--timeout S] [--raw] "<prompt>"   (prompt may also come on stdin)
                        Non-interactive Codex reasoning offload: codex exec -m gpt-5.6-luna
                        --sandbox read-only --skip-git-repo-check -C DIR. The model is
                        pinned (no fallback); prints only the final answer (--raw: all).
  --notify EVENTS.jsonl [--routine REGEX_FILE] [--settle S] [--stale S]
           [--done-kinds END,EMPTY] [--alive FILE] [--then "CMD"]
                        One-shot notifier over another logger's JSONL log, from its
                        current end (read-only). Exits on the first event whose
                        "KIND text" matches no routine regex, SETTLE s after the first
                        done-kind event, or when EVENTS.alive is older than STALE s;
                        then runs --then CMD and prints its output.
  --hygiene [--repo P] [--memory-max-bytes N] [--memory-max-files N]   read-only: removable/outside worktrees, memory size
  --move-verify SRC DST [--bwlimit KBPS] [--no-lsof] [--verify-only]
                        ionice/nice rsync -a SRC/ DST/, then verify (rsync --checksum
                        dry-run lists nothing + equal file counts/byte totals). Prints
                        VERIFIED and the exact `! rm -rf SRC && ln -s DST SRC` line for
                        the USER. Never deletes anything.
  --hash-repro --want sha256:<hex|prefix> [--timeout S] [--log FILE.jsonl] -- CMD...
                        Runs a metadata-only identity command (CPU-only: CUDA hidden, 2 threads,
                        nice 15, timeout default 1800 s), collects every sha256:<hex> it prints
                        and passes only if one starts with --want. One line: hash-repro PASS|FAIL.
  --teardown SPEC.json [--out SCRIPT.sh]
                        Generates (does not run) a dry-run-by-default stop script from a spec
                        (name, tmux_session, groups, expect, busy_ports, keep_listening, log,
                        after_cmd): identity checks, port checks, CONFIRM=1 kills windows group
                        by group (never kill-session), JSONL log. Default out: stop_<name>.sh.
  --coldbank list|put|fetch|run|release|cat|status|gc|verify ...
                        westeros cold bank (big store) + per-host size-budgeted caches:
                        `fetch NAME` copies + sha256-verifies on demand (LRU eviction of
                        unleased cache copies), `run NAME -- CMD` leases it for CMD.
                        Design: CDX-AGENT/docs/coldbank.md.
  --gpu-lock HOLD_JOBID [--n K | --gpu G[,G2]] [--eta MIN] [--host rlab1] [--gres G] [--mem M]
             [--dry-run] -- CMD...
                        Run CMD as `ssh HOST srun --jobid=HOLD --overlap ...` inside a
                        shared GPU hold: takes K free flock locks in
                        /freespace/local/ss5772/gpu_locks/gpu<G>.lock, writes gpu<G>.owner,
                        exports CUDA_VISIBLE_DEVICES, releases on exit. NFS guard: the
                        wrapper and a shell-script CMD are snapshotted to node-local disk
                        and the copies run (an NFS script edited mid-run dies with
                        "Stale file handle"); --no-snapshot skips. --dry-run prints srun.
  --gpu-lock --status [--node NODE]
                        List GPU lock holders and owner files (default node rlab2).
  --brief <WORKTREE|BRANCH> [--base B] [--max-tokens 3000] [--rules FILE]
                        Deterministic no-LLM context brief to seed a FRESH subagent/Codex
                        worker (instead of forking/resuming a long session): branch, HEAD,
                        base + merge-base, commits, changed files, TODO/Open/Next of changed
                        docs/runbooks + docs/status/*todo*, changed reports/** headlines,
                        base/brief_rules.md, output contract. Capped at ~4 chars/token.

Jobs and helpers (more of the same family, each consumes the rest of argv):
  --cpu-job [--node N] [--threads 8] [--mem 16G] [--time 2:00:00] [--wait] [--dry-run] -- CMD
                        Run CPU-heavy work (tests, replays, data generation) on the ilab node (not rlab) with the
                        most idle CPUs (sinfo), thread limits set; sbatch by default (prints job/node/log),
                        --wait = srun in the foreground with --timeout. Use when a workstation is loaded. Refuses (prints the niced
                        local background command) when repo data symlinks / command paths resolve under /data/local (--allow-local-data).
  --watch [--job ID[:NAME]] [--tmux NAME[:LOG[:DONE_RE[:FAIL_RE]]]] [--log NAME:PATH:DONE_RE[:FAIL_RE]] [--spec F.json] --out-dir D
                        ONE background watcher for many runs: status.md/status.jsonl, Codex summary per finished item
                        (spec "summary"), exits once: 0 all done / 2 first failure / 3 timeout. Run it with run_in_background.
  --agent-usage [--tasks-dir D] [--active-only] [--json]
                        Per Claude subagent: tokens (incl. cache reads), transcript MB, last action, WAITING/IDLE/BIG flags.
  --gpu-pick --gpu-type a4000[,4500_ada] [--n 1] [--cap 8] [--per-node-clients 4] [--shared-clients 2] [--mem 60G] [--cpus 1] [--min-disk-gb 50]
                        Node a job can really start on (free GPUs within the user cap (GrpTRES gpu=8, node=1: all running jobs must share ONE node) = RUNNING jobs only, free RAM >= --mem,
                        free CPUs >= --cpus, not PLANNED/DRAIN/DOWN/RESERVED, Isaac client limit, node-local disk) -> sbatch
                        options incl. --mem; one line per rejected node.
  --gpu-pick --status [--mem 60G] [--workstations westeros,arrakis]
                        Inventory: per Slurm node GPUs / CPUs / RAM free and whether a job can start (else why), our running/
                        pending/held GPUs vs the cap, and the workstations' nvidia-smi with process owners.
  --handoff [--repo DIR] [--out FILE] [--base main] [--branches GLOB] [--since-hours 24] [--notes FILE]
            [--slurm-host HOST] [--no-slurm] [--no-gpu] [--max-tokens 4000]
                        Deterministic machine-written handoff (worktrees, Slurm jobs, GPUs, tmux names,
                        report headlines, open items, agent notes, resume line) to restart a long main
                        session fresh at a breakpoint. Default out: docs/status/<date>_handoff_auto.md.
                        Slurm via squeue, else ssh $CDX_SLURM_HOST (default rlab1).

  --run [--dry-run] ... -- CMD
                        Place and run a command: a step inside your GPU hold, a Slurm job, a westeros GPU
                        or locally. `cdx-agent --run --help` for the routing rules.
  --suite [...]         Per-file pytest fan-out with the test-routing map. `cdx-agent --suite --help`.

Skills:
  --validate-skills                 Validate SKILL.md metadata and warnings.
  --skills-list                     List discovered skills and their roots.
  --skills-audit                    Audit discovered skills for risky patterns.

Wrapper flags:
  --claude              Use the Claude engine (default).
  --codex               Use the Codex engine.
  --secondary           Start a secondary session next to the active one.
  --safe                Launch with the workspace-write sandbox.
  --full                Launch with full access (default).
  --token-saver         Enable token-saving wrapper behavior.
  --no-token-saver      Disable token-saving wrapper behavior.
  --repo PATH           Target PATH for graph/context operations.
  --force-home-scan     Allow graph scanning the home directory.
  --repo-local          Force --install-hooks to use repo-local hooks.
  --runtime             Force --install-hooks to use runtime hooks.
  --yes                 Skip confirmation prompts used by init/install modes,
                        including --init-repo --yes.
  --dry-run             Print the engine command without executing it (modes that support it).
  -h, --help            Show this help and exit.

Session cleanup:
  --cancel-active       If this repo has an active/stale session, kill
                        matching repo/session processes, move the runtime
                        aside, and continue
  --no-cancel-active    Do not prompt for active-session cleanup; exit on
                        conflict
  --takeover            Claude: cancel the active session, then relaunch
                        with --resume <that session>, so the conversation
                        carries over; interrupted background agents can be
                        resumed from it by messaging their ids. (Background
                        agents/shells live inside the session process, so
                        any cancel stops them; transcripts are kept.)
  --drain SECONDS       With --cancel-active/--takeover: first wait up to
                        SECONDS for the old session's background agents and
                        shells to stop writing output (default 0)

Behavior:
  - Default mode is launch: it prepares the repo/runtime layout and starts the selected engine.
  - Unrecognized arguments are forwarded to the engine after wrapper parsing.
    This includes engine subcommands such as resume.
  - --compress-output consumes the rest of argv as the wrapped command.
  - --offload, --notify, --move-verify, --gpu-lock, --brief, --handoff, --cpu-job, --watch, --agent-usage, --gpu-pick, --coldbank, --hash-repro, --teardown, --run and --suite also consume the rest of argv.
  - Modes that support it honor --dry-run or CDX_DRY_RUN=1.
  - --token-saver can be combined with --full or --safe.
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --validate-skills)
      MODE="validate-skills"
      shift
      ;;
    --skills-list)
      MODE="skills-list"
      shift
      ;;
    --skills-audit)
      MODE="skills-audit"
      shift
      ;;
    --init-tools)
      MODE="init-tools"
      shift
      ;;
    --init-repo)
      MODE="init-repo"
      shift
      ;;
    --session-doctor)
      MODE="session-doctor"
      shift
      ;;
    --detect-deps)
      MODE="detect-deps"
      shift
      ;;
    --init-workspace)
      MODE="init-workspace"
      shift
      ;;
    --graph)
      MODE="graph"
      shift
      ;;
    --workspace-graph)
      MODE="workspace-graph"
      shift
      ;;
    --workspace-doctor)
      MODE="workspace-doctor"
      shift
      ;;
    --review)
      MODE="review"
      shift
      ;;
    --install-token-tools)
      MODE="install-token-tools"
      shift
      ;;
    --compress-output)
      MODE="compress-output"
      shift
      COMPRESS_COMMAND=("$@")
      break
      ;;
    --offload|--notify|--move-verify|--gpu-lock|--brief|--handoff|--cpu-job|--watch|--agent-usage|--gpu-pick|--coldbank|--hash-repro|--teardown|--hygiene|--deploy|--value|--rm|--trash|--inuse|--site-facts|--verify-log|--suite|--check|--run)
      MODE="${1#--}"
      shift
      MODULE_ARGS=("$@")
      break
      ;;
    --summarize-log)
      MODE="summarize-log"
      shift
      TARGET_LOG_FILE="${1:-}"
      [[ $# -gt 0 ]] && shift || true
      ;;
    --context-budget)
      MODE="context-budget"
      shift
      ;;
    --install-hooks)
      MODE="install-hooks"
      shift
      ;;
    --token-saver)
      TOKEN_SAVER=1
      shift
      ;;
    --no-token-saver)
      TOKEN_SAVER=0
      shift
      ;;
    --cancel-active)
      CANCEL_ACTIVE=1
      NO_CANCEL_ACTIVE=0
      shift
      ;;
    --no-cancel-active)
      NO_CANCEL_ACTIVE=1
      CANCEL_ACTIVE=0
      TAKEOVER=0
      shift
      ;;
    --takeover)
      TAKEOVER=1
      NO_CANCEL_ACTIVE=0
      shift
      ;;
    --drain)
      [[ $# -ge 2 ]] || { echo "--drain needs SECONDS" >&2; exit 2; }
      DRAIN_SECONDS="$2"
      shift 2
      ;;
    --drain=*)
      DRAIN_SECONDS="${1#--drain=}"
      shift
      ;;
    --safe)
      ACCESS_MODE="safe"
      shift
      ;;
    --full)
      ACCESS_MODE="full"
      shift
      ;;
    --claude)
      ENGINE="claude"
      shift
      ;;
    --codex)
      ENGINE="codex"
      shift
      ;;
    --secondary)
      SECONDARY=1
      shift
      ;;
    --repo)
      shift
      TARGET_REPO="${1:-}"
      if [[ -z "$TARGET_REPO" ]]; then
        echo "Missing path for --repo" >&2
        exit 1
      fi
      shift
      ;;
    --force-home-scan)
      FORCE_HOME_SCAN=1
      shift
      ;;
    --repo-local)
      INSTALL_TARGET="repo"
      shift
      ;;
    --runtime)
      INSTALL_TARGET="runtime"
      shift
      ;;
    --yes)
      YES=1
      shift
      ;;
    --dry-run)
      DRY_RUN=1
      shift
      ;;
    -h|--help)
      MODE="help"
      shift
      break
      ;;
    *)
      if [[ "$1" == "--" ]]; then
        SEEN_SEPARATOR=1
      elif [[ "$SEEN_SEPARATOR" -eq 0 && "$1" == --* ]]; then
        # Unknown --flag before "--": ask the mode registry for the nearest flag and stop (F13).
        PYTHONPATH="$CDX_AGENT_PYTHONPATH${PYTHONPATH:+:$PYTHONPATH}" python3 -m cdx_agent.modes --check-flag "$1" || exit 2
      fi
      PASSTHROUGH+=("$1")
      shift
      ;;
  esac
done

# Dry-run contract (F3): a mode that does not support --dry-run refuses it instead of running for real.
if [[ "$MODE" != "launch" && "$MODE" != "help" ]] && cdx_is_dry_run; then
  dry_rc=0
  PYTHONPATH="$CDX_AGENT_PYTHONPATH${PYTHONPATH:+:$PYTHONPATH}" python3 -m cdx_agent.modes --supports-dry-run "--$MODE" || dry_rc=$?
  if [[ "$dry_rc" -eq 3 ]]; then
    echo "cdx-agent: --$MODE has no dry run" >&2
    exit 2
  fi
fi

case "$MODE" in
  validate-skills)
    cdx_agent_py validate-skills --repo "$(current_dir)"
    ;;
  skills-list)
    cdx_agent_py skills-list --repo "$(current_dir)"
    ;;
  skills-audit)
    cdx_agent_py skills-audit --repo "$(current_dir)"
    ;;
  init-tools)
    ensure_tools_layout
    ensure_repo_graph_pythonpath
    echo "Initialized or verified local Codex tools under $TOOLS_ROOT"
    echo "repo_graph_pythonpath=$REPO_GRAPH_PYTHONPATH"
    echo "pth_link=$SITE_PTH"
    echo "token_tools_root=$TOKEN_TOOLS_ROOT"
    echo "hooks_root=$HOOKS_ROOT"
    echo "skills_root=$TOOLS_ROOT/skills"
    echo "subagent_prompts_root=$TOOLS_ROOT/subagent_prompts"
    echo "mcp_fragment=$DISABLED_MCP_FRAGMENT"
    ;;
  init-repo)
    run_init_repo
    ;;
  detect-deps)
    run_repo_graph_detect_deps "$(guarded_graph_target_dir)"
    ;;
  init-workspace)
    run_repo_graph_init_workspace "$(guarded_graph_target_dir)"
    ;;
  graph)
    run_graph_only
    ;;
  workspace-graph)
    run_repo_graph_workspace_graph "$(guarded_graph_target_dir)"
    ;;
  workspace-doctor)
    run_repo_graph_workspace_doctor "$(guarded_graph_target_dir)"
    ;;
  session-doctor)
    if [[ "$ACCESS_MODE" == "full" ]]; then
      cdx_agent_py session-doctor --repo "$(current_dir)" --engine "$ENGINE" --full
    else
      cdx_agent_py session-doctor --repo "$(current_dir)" --engine "$ENGINE" --safe
    fi
    ;;
  review)
    review_repo
    ;;
  install-token-tools)
    install_token_tools
    ;;
  compress-output)
    run_compress_output
    ;;
  summarize-log)
    run_summarize_log
    ;;
  context-budget)
    run_context_budget
    ;;
  install-hooks)
    cdx_agent_py install-hooks --repo "$(guarded_graph_target_dir)" --engine "$ENGINE"
    ;;
  offload)
    if [[ -n "$TARGET_REPO" ]]; then
      cdx_agent_mod offload --repo "$TARGET_REPO" "${MODULE_ARGS[@]}"
    else
      cdx_agent_mod offload "${MODULE_ARGS[@]}"
    fi
    ;;
  notify)
    cdx_agent_mod notify "${MODULE_ARGS[@]}"
    ;;
  move-verify)
    cdx_agent_mod move_verify "${MODULE_ARGS[@]}"
    ;;
  hygiene)
    if [[ -n "$TARGET_REPO" ]]; then
      cdx_agent_py hygiene --repo "$TARGET_REPO" "${MODULE_ARGS[@]}"
    else
      cdx_agent_py hygiene "${MODULE_ARGS[@]}"
    fi
    ;;
  coldbank)
    cdx_agent_mod coldbank "${MODULE_ARGS[@]}"
    ;;
  deploy)
    if cdx_is_dry_run; then cdx_agent_mod deploy --dry-run "${MODULE_ARGS[@]}"; else cdx_agent_mod deploy "${MODULE_ARGS[@]}"; fi
    ;;
  value)
    cdx_agent_mod values "${MODULE_ARGS[@]}"
    ;;
  rm)
    if cdx_is_dry_run; then cdx_agent_mod trash rm --dry-run "${MODULE_ARGS[@]}"; else cdx_agent_mod trash rm "${MODULE_ARGS[@]}"; fi
    ;;
  trash)
    cdx_agent_mod trash "${MODULE_ARGS[@]}"
    ;;
  inuse)
    cdx_agent_mod inuse "${MODULE_ARGS[@]}"
    ;;
  verify-log)
    cdx_agent_mod verify_log "${MODULE_ARGS[@]}"
    ;;
  suite)
    cdx_agent_mod suite "${MODULE_ARGS[@]}"
    ;;
  run)
    if cdx_is_dry_run; then cdx_agent_mod run --dry-run "${MODULE_ARGS[@]}"; else cdx_agent_mod run "${MODULE_ARGS[@]}"; fi
    ;;
  check)
    cdx_agent_mod check "${MODULE_ARGS[@]}"
    ;;
  site-facts)
    cdx_agent_mod site_facts "${MODULE_ARGS[@]}"
    ;;
  cpu-job)
    cdx_agent_mod cpu_job "${MODULE_ARGS[@]}"
    ;;
  watch)
    cdx_agent_mod watch "${MODULE_ARGS[@]}"
    ;;
  agent-usage)
    cdx_agent_mod agent_usage "${MODULE_ARGS[@]}"
    ;;
  gpu-pick)
    CDX_SLURM_HOST="${CDX_SLURM_HOST:-rlab1}" cdx_agent_mod gpu_pick "${MODULE_ARGS[@]}"
    ;;
  handoff)
    if [[ -n "$TARGET_REPO" ]]; then
      CDX_SLURM_HOST="${CDX_SLURM_HOST:-rlab1}" cdx_agent_mod handoff --repo "$TARGET_REPO" "${MODULE_ARGS[@]}"
    else
      CDX_SLURM_HOST="${CDX_SLURM_HOST:-rlab1}" cdx_agent_mod handoff "${MODULE_ARGS[@]}"
    fi
    ;;
  brief)
    if [[ -n "$TARGET_REPO" ]]; then
      cdx_agent_mod brief --rules "$TOOLS_ROOT/base/brief_rules.md" --repo "$TARGET_REPO" "${MODULE_ARGS[@]}"
    else
      cdx_agent_mod brief --rules "$TOOLS_ROOT/base/brief_rules.md" "${MODULE_ARGS[@]}"
    fi
    ;;
  gpu-lock)
    if cdx_is_dry_run; then
      cdx_agent_mod gpu_lock --dry-run "${MODULE_ARGS[@]}"
    else
      cdx_agent_mod gpu_lock "${MODULE_ARGS[@]}"
    fi
    ;;
  hash-repro)
    cdx_agent_mod hash_repro "${MODULE_ARGS[@]}"
    ;;
  teardown)
    cdx_agent_mod teardown "${MODULE_ARGS[@]}"
    ;;
  launch)
    launch_codex
    ;;
  help)
    print_usage
    ;;
  *)
    echo "Unknown mode: $MODE"
    exit 1
    ;;
esac

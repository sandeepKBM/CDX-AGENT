#!/usr/bin/env bash
set -euo pipefail

SELF_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
USER_ROOT="/common/users/ss5772"
ACCOUNT_HOME="/common/home/ss5772"
TOOLS_ROOT="$USER_ROOT/codex_tools"
TOKEN_TOOLS_ROOT="$TOOLS_ROOT/token_tools"
SKILL_VALIDATOR_SCRIPT="$TOKEN_TOOLS_ROOT/validate_skills.py"
HOOKS_ROOT="$TOOLS_ROOT/hooks"
LEGACY_WRAPPER="$USER_ROOT/bin/cdx-danger-auto"
BASE_AGENTS_TEMPLATE="$TOOLS_ROOT/base/AGENTS.md"
REPO_AGENTS_TEMPLATE="$TOOLS_ROOT/templates/repo.AGENTS.md"
HOOKS_EXAMPLE="$TOOLS_ROOT/hooks/hooks.example.json"
REPO_GRAPH_ROOT="$TOOLS_ROOT/repo_graph_agent"
REPO_GRAPH_PYTHONPATH="$REPO_GRAPH_ROOT"
SITE_PTH="$ACCOUNT_HOME/.local/lib/python3.12/site-packages/codex_tools_repo_graph_agent.pth"
# CDX-AGENT Python package (the revamp: safety-hardened runtime/session/skills/hooks
# provisioning, plus Claude Code launch support). Same PYTHONPATH-injection pattern as
# REPO_GRAPH_PYTHONPATH above, so no pip install is required for bash to delegate to it.
CDX_AGENT_PYTHONPATH="$ACCOUNT_HOME/CDX-AGENT/src"
DISABLED_MCP_FRAGMENT="$TOOLS_ROOT/base/mcp.repo_graph.example.toml.disabled"
TOOLS_SKILLS_ROOT="$TOOLS_ROOT/skills"
SKILLS_APPROVED_ROOT="$TOOLS_ROOT/skills_approved"
SKILLS_CUSTOM_ROOT="$TOOLS_ROOT/skills_custom"
SKILLS_QUARANTINE_ROOT="$TOOLS_ROOT/skills_quarantine"
USER_AGENTS_SKILLS_ROOT="$ACCOUNT_HOME/.agents/skills"
WORKSPACE_MANIFEST_ROOT="/common/users/ss5772/.cdx/workspaces"
WORKSPACE_MIRROR_ROOT="/common/users/ss5772/.cdx/dg_workspaces"

MODE="launch"
ACCESS_MODE="full"
# Default engine for a bare `cdx-agent` invocation. Kept in sync with
# cdx_agent.launch.DEFAULT_ENGINE in the Python package (CDX-AGENT/src) --
# that's the single other place this default lives. Override per-invocation
# with --claude/--codex, or edit both this line and DEFAULT_ENGINE to change
# the default itself.
ENGINE="claude"
SECONDARY=0
TOKEN_SAVER=0
YES=0
DRY_RUN=0
DG_WORKSPACE_FORCE=0
CANCEL_ACTIVE=0
NO_CANCEL_ACTIVE=0
TAKEOVER=0
DRAIN_SECONDS=0
INSTALL_TARGET="auto"
TARGET_LOG_FILE=""
CURRENT_LOGDIR=""
COMPRESS_COMMAND=()
MODULE_ARGS=()   # rest of argv for --offload/--notify/--move-verify/--gpu-lock/--brief (cdx_agent.<module>)
TARGET_REPO=""
FORCE_HOME_SCAN=0
PASSTHROUGH=()
DG_ROOT_OVERRIDE=""
DG_WORKSPACE_SPEC=""
DG_WORKSPACE_INIT_NAME=""
DG_WORKSPACE_INIT_PATHS=()

if [[ "${CDX_DRY_RUN:-0}" == "1" ]]; then
  DRY_RUN=1
fi

timestamp() {
  date +"%Y%m%d_%H%M%S"
}

hostname_short() {
  hostname -s
}

have_cmd() {
  command -v "$1" >/dev/null 2>&1
}

current_dir() {
  pwd -P
}

cdx_is_dry_run() {
  [[ "${CDX_DRY_RUN:-0}" == "1" || "$DRY_RUN" -eq 1 ]]
}

cdx_abs_path() {
  local path="$1"
  if have_cmd readlink; then
    readlink -f "$path"
  else
    python3 -c 'import os, sys; print(os.path.abspath(sys.argv[1]))' "$path"
  fi
}

cdx_sanitize_name() {
  printf '%s' "$1" | sed 's/[^A-Za-z0-9._-]/_/g'
}

cdx_validate_workspace_name() {
  local name="$1"
  if [[ -z "$name" || "$name" == "." || "$name" == ".." || "$name" == *"/"* ]]; then
    return 1
  fi
  [[ "$name" =~ ^[A-Za-z0-9_.-]+$ ]]
}

cdx_workspace_name_from_spec() {
  local spec="$1"
  local base
  if [[ -f "$spec" ]]; then
    base="$(basename "$spec")"
    base="${base%.paths}"
    printf '%s' "$(cdx_sanitize_name "$base")"
    return 0
  fi
  if ! cdx_validate_workspace_name "$spec"; then
    return 1
  fi
  printf '%s' "$spec"
}

cdx_workspace_manifest_path() {
  local spec="$1"
  if [[ -f "$spec" ]]; then
    cdx_abs_path "$spec"
    return 0
  fi
  if ! cdx_validate_workspace_name "$spec"; then
    echo "Invalid workspace name: $spec" >&2
    return 1
  fi
  printf '%s/%s.paths' "$WORKSPACE_MANIFEST_ROOT" "$spec"
}

cdx_workspace_entries() {
  local manifest="$1"
  local manifest_dir raw resolved
  manifest_dir="$(dirname "$manifest")"
  while IFS= read -r raw || [[ -n "$raw" ]]; do
    raw="${raw%$'\r'}"
    [[ "$raw" =~ ^[[:space:]]*$ ]] && continue
    [[ "$raw" =~ ^[[:space:]]*# ]] && continue
    if [[ "$raw" = /* ]]; then
      resolved="$(cdx_abs_path "$raw")"
    else
      resolved="$(cdx_abs_path "$manifest_dir/$raw")"
    fi
    printf '%s\t%s\n' "$resolved" "$raw"
  done < "$manifest"
}

cdx_workspace_mirror_path() {
  local spec="$1"
  local name
  name="$(cdx_workspace_name_from_spec "$spec")"
  printf '%s/%s' "$WORKSPACE_MIRROR_ROOT" "$name"
}

cdx_need_dg() {
  if command -v dg >/dev/null 2>&1; then
    return 0
  fi
  echo "ERROR: dg not found on PATH." >&2
  echo >&2
  echo "To inspect/install GrapeRoot/Dual-Graph safely:" >&2
  echo "  cd /common/users/ss5772/codex_tools" >&2
  echo "  git clone https://github.com/kunal12203/Codex-CLI-Compact.git" >&2
  echo "  cd Codex-CLI-Compact" >&2
  echo "  less README.md" >&2
  echo "  less install.sh" >&2
  echo "  find . -maxdepth 3 -type f | sort" >&2
  echo >&2
  echo "Do not run curl-pipe-bash. Install only after inspection." >&2
  return 1
}

cdx_collect_runtime_skill_roots() {
  local repo
  repo="$(repo_root)"
  printf '%s\n' \
    "$TOOLS_SKILLS_ROOT" \
    "$SKILLS_APPROVED_ROOT" \
    "$SKILLS_CUSTOM_ROOT" \
    "$USER_AGENTS_SKILLS_ROOT" \
    "$repo/.agents/skills"
}

cdx_link_skill_root() {
  local src_root="$1"
  local dst_root="$2"
  local skill_dir skill_name target existing
  [[ -d "$src_root" ]] || return 0
  while IFS= read -r -d '' skill_dir; do
    skill_name="$(basename "$skill_dir")"
    target="$dst_root/$skill_name"
    if [[ -L "$target" ]]; then
      existing="$(readlink -f "$target" || true)"
      if [[ "$existing" == "$(readlink -f "$skill_dir")" ]]; then
        continue
      fi
    fi
    if [[ -e "$target" || -L "$target" ]]; then
      backup_path "$target" >/dev/null || true
      rm -rf "$target"
    fi
    ln -s "$skill_dir" "$target"
  done < <(find "$src_root" -mindepth 1 -maxdepth 1 -type d -print0)
}

cdx_safe_remove_tree() {
  local target="$1"
  local resolved
  resolved="$(cdx_abs_path "$target")"
  case "$resolved" in
    "$WORKSPACE_MIRROR_ROOT"/*)
      ;;
    *)
      echo "Refusing to delete outside $WORKSPACE_MIRROR_ROOT: $resolved" >&2
      return 1
      ;;
  esac
  rm -rf -- "$resolved"
}

cdx_resolve_dg_root() {
  local root="$1"
  root="$(cdx_abs_path "$root")"
  if [[ ! -d "$root" ]]; then
    echo "DG root is not a directory: $root" >&2
    return 1
  fi
  if is_home_like_dir "$root" && [[ "$FORCE_HOME_SCAN" -ne 1 ]]; then
    echo "Refusing to run dg against a home-like directory: $root" >&2
    echo "Use --force-home-scan only if you really intend that scan." >&2
    return 1
  fi
  printf '%s' "$root"
}

cdx_dg_preflight() {
  local mode="$1"
  local root="$2"
  local dg_bin
  dg_bin="$(command -v dg 2>/dev/null || true)"
  echo "MODE=$mode"
  echo "REPO_ROOT=$root"
  echo "DG_BIN=${dg_bin:-missing}"
  echo "CODEX_HOME=$(current_codex_home)"
}

cdx_run_dg() {
  local mode="$1"
  local root="$2"
  shift 2
  local dg_bin
  if ! cdx_need_dg; then
    return 1
  fi
  dg_bin="$(command -v dg)"
  cdx_dg_preflight "$mode" "$root"
  if cdx_is_dry_run; then
    printf 'DRY_RUN_COMMAND='
    printf '%q ' "$dg_bin" "$root" "$@"
    printf '\n'
    return 0
  fi
  exec "$dg_bin" "$root" "$@"
}

cdx_run_dg_workspace() {
  local mode="$1"
  local spec="$2"
  shift 2
  local manifest name mirror_root
  if ! cdx_need_dg; then
    return 1
  fi
  manifest="$(cdx_workspace_manifest_path "$spec")"
  name="$(cdx_workspace_name_from_spec "$spec")"
  mirror_root="$(cdx_workspace_mirror_path "$spec")"
  echo "MODE=$mode"
  echo "WORKSPACE_NAME=$name"
  echo "WORKSPACE_MANIFEST=$manifest"
  echo "WORKSPACE_MIRROR=$mirror_root"
  echo "CODEX_HOME=$(current_codex_home)"

  local -a entries=()
  local entry resolved raw link_name count
  local -A seen_links=()
  mapfile -t entries < <(cdx_workspace_entries "$manifest")
  if [[ "${#entries[@]}" -eq 0 ]]; then
    echo "Workspace manifest has no entries: $manifest" >&2
    return 1
  fi
  for entry in "${entries[@]}"; do
    resolved="${entry%%$'\t'*}"
    raw="${entry#*$'\t'}"
    if [[ ! -d "$resolved" ]]; then
      echo "Workspace path is missing or not a directory: $resolved (from $raw)" >&2
      return 1
    fi
    if is_home_like_dir "$resolved" && [[ "$FORCE_HOME_SCAN" -ne 1 ]]; then
      echo "Refusing to scan a home-like workspace path: $resolved (from $raw)" >&2
      echo "Use --force-home-scan only if you really intend that scan." >&2
      return 1
    fi
  done

  if cdx_is_dry_run; then
    echo "DRY_RUN_MIRROR_CONTENTS:"
    for entry in "${entries[@]}"; do
      resolved="${entry%%$'\t'*}"
      raw="${entry#*$'\t'}"
      link_name="$(cdx_sanitize_name "$(basename "$resolved")")"
      count="${seen_links[$link_name]:-0}"
      if [[ "$count" -gt 0 ]]; then
        link_name="${link_name}-$((count + 1))"
      fi
      seen_links["$(cdx_sanitize_name "$(basename "$resolved")")"]=$((count + 1))
      printf '  %s -> %s (from %s)\n' "$link_name" "$resolved" "$raw"
    done
    printf 'DRY_RUN_COMMAND='
    printf '%q ' "$(command -v dg)" "$mirror_root" "$@"
    printf '\n'
    return 0
  fi

  cdx_safe_remove_tree "$mirror_root" >/dev/null 2>&1 || true
  mkdir -p "$mirror_root"
  local index_file="$mirror_root/WORKSPACE_INDEX.md"
  {
    printf '# Workspace Index\n'
    printf '\n'
    printf '- Workspace: %s\n' "$name"
    printf '- Manifest: %s\n' "$manifest"
    printf '- Generated: %s\n' "$(date '+%Y-%m-%d %H:%M:%S %Z')"
    printf '\n'
    printf 'Warning: editing files through this mirror edits the original source paths.\n'
    printf 'Map every change back to the original source path before editing.\n'
    printf '\n'
    printf '## Entries\n'
  } > "$index_file"

  for entry in "${entries[@]}"; do
    resolved="${entry%%$'\t'*}"
    raw="${entry#*$'\t'}"
    link_name="$(cdx_sanitize_name "$(basename "$resolved")")"
    count="${seen_links[$link_name]:-0}"
    if [[ "$count" -gt 0 ]]; then
      link_name="${link_name}-$((count + 1))"
    fi
    seen_links["$(cdx_sanitize_name "$(basename "$resolved")")"]=$((count + 1))
    ln -s "$resolved" "$mirror_root/$link_name"
    printf '- `%s` -> `%s` (from `%s`)\n' "$link_name" "$resolved" "$raw" >> "$index_file"
  done

  cdx_run_dg "$mode" "$mirror_root" "$@"
}

cdx_init_dg_workspace() {
  local name="$1"
  shift
  local manifest="$WORKSPACE_MANIFEST_ROOT/$name.paths"
  local -a paths=("$@")
  local path resolved
  if [[ "${#paths[@]}" -eq 0 ]]; then
    echo "No directories provided for workspace init." >&2
    return 1
  fi
  for path in "${paths[@]}"; do
    if [[ ! -d "$path" ]]; then
      echo "Workspace path is not a directory: $path" >&2
      return 1
    fi
  done
  if [[ -e "$manifest" && "$DG_WORKSPACE_FORCE" -ne 1 ]]; then
    echo "Workspace manifest already exists: $manifest (use --force to overwrite)" >&2
    return 1
  fi
  if cdx_is_dry_run; then
    echo "MANIFEST=$manifest"
    for path in "${paths[@]}"; do
      resolved="$(cdx_abs_path "$path")"
      printf '  %s\n' "$resolved"
    done
    return 0
  fi
  mkdir -p "$WORKSPACE_MANIFEST_ROOT"
  if [[ -e "$manifest" ]]; then
    backup_path "$manifest" >/dev/null || true
  fi
  : > "$manifest"
  for path in "${paths[@]}"; do
    resolved="$(cdx_abs_path "$path")"
    printf '%s\n' "$resolved" >> "$manifest"
  done
  echo "Created workspace manifest: $manifest"
}

cdx_list_dg_workspaces() {
  local found=0 manifest name
  if [[ ! -d "$WORKSPACE_MANIFEST_ROOT" ]]; then
    echo "No workspace manifests found in $WORKSPACE_MANIFEST_ROOT"
    return 0
  fi
  while IFS= read -r manifest; do
    [[ -n "$manifest" ]] || continue
    name="$(basename "$manifest")"
    name="${name%.paths}"
    printf '%s -> %s\n' "$name" "$manifest"
    found=1
  done < <(find "$WORKSPACE_MANIFEST_ROOT" -maxdepth 1 -type f -name '*.paths' | sort)
  if [[ "$found" -eq 0 ]]; then
    echo "No workspace manifests found in $WORKSPACE_MANIFEST_ROOT"
  fi
}

cdx_show_dg_workspace() {
  local spec="$1"
  local manifest
  manifest="$(cdx_workspace_manifest_path "$spec")"
  echo "MANIFEST=$manifest"
  while IFS=$'\t' read -r resolved raw; do
    if [[ -d "$resolved" ]]; then
      printf 'present\t%s\t%s\n' "$resolved" "$raw"
    else
      printf 'missing\t%s\t%s\n' "$resolved" "$raw"
    fi
  done < <(cdx_workspace_entries "$manifest")
}

cdx_clean_dg_workspace() {
  local spec="$1"
  local mirror_root
  mirror_root="$(cdx_workspace_mirror_path "$spec")"
  if [[ ! -d "$mirror_root" ]]; then
    echo "No generated mirror to remove: $mirror_root"
    return 0
  fi
  cdx_safe_remove_tree "$mirror_root"
  echo "Removed generated mirror: $mirror_root"
}

cdx_skill_root_status() {
  local path="$1"
  if [[ -d "$path" ]]; then
    echo "present"
  else
    echo "missing"
  fi
}

is_git_repo() {
  git rev-parse --is-inside-work-tree >/dev/null 2>&1
}

repo_root() {
  if is_git_repo; then
    git rev-parse --show-toplevel
  else
    pwd -P
  fi
}

looks_like_project_dir() {
  local dir
  dir="$(readlink -f "$1")"
  [[ -f "$dir/pyproject.toml" ]] || \
  [[ -f "$dir/setup.py" ]] || \
  [[ -f "$dir/setup.cfg" ]] || \
  [[ -f "$dir/requirements.txt" ]] || \
  [[ -f "$dir/package.json" ]] || \
  [[ -f "$dir/Cargo.toml" ]] || \
  [[ -f "$dir/AGENTS.md" ]]
}

is_home_like_dir() {
  local dir home_dir
  dir="$(readlink -f "$1")"
  home_dir="$(readlink -f "${HOME:-$USER_ROOT}")"
  [[ "$dir" == "$USER_ROOT" ]] || [[ "$dir" == "$ACCOUNT_HOME" ]] || [[ "$dir" == "$home_dir" ]]
}

guarded_graph_target_dir() {
  local base target git_target
  if [[ -n "$TARGET_REPO" ]]; then
    base="$(readlink -f "$TARGET_REPO")"
  else
    base="$(current_dir)"
  fi
  if [[ ! -d "$base" ]]; then
    echo "Graph target is not a directory: $base" >&2
    exit 1
  fi
  target="$(readlink -f "$base")"
  if is_home_like_dir "$target" && [[ "$FORCE_HOME_SCAN" -ne 1 ]]; then
    echo "You are in your home directory. Refusing to graph-scan the whole home tree. cd into a repo first, or pass --repo <path> / --force-home-scan." >&2
    exit 1
  fi
  git_target="$(git -C "$base" rev-parse --show-toplevel 2>/dev/null || true)"
  if [[ -n "$git_target" ]]; then
    printf '%s' "$(readlink -f "$git_target")"
    return 0
  fi
  if looks_like_project_dir "$target"; then
    printf '%s' "$target"
    return 0
  fi
  echo "Current directory does not look like a repo or project. cd into a repo first, or pass --repo <path>." >&2
  exit 1
}

repo_name() {
  basename "$(repo_root)"
}

repo_slug() {
  local repo hash base
  repo="$(repo_root)"
  base="$(basename "$repo" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9._-]/_/g')"
  hash="$(printf '%s' "$repo" | sha1sum | awk '{print substr($1,1,10)}')"
  printf '%s__%s' "$base" "$hash"
}

runtime_codex_home() {
  # Fix (A1, matches cdx_agent.runtime.runtime_home): fold engine + access
  # mode into the path itself, so full/safe and codex/claude never share a
  # runtime directory (config.toml/auth.json/lock/skills) for the same repo.
  # Previously this omitted both, and current_codex_home()'s "full" vs.
  # non-"full" branches both called this exact same function -- a dead-code
  # bug that meant --safe silently inherited full-access state.
  local repo_slug_value host
  host="$(hostname_short)"
  repo_slug_value="$(repo_slug)"
  printf '%s/codex_runtime/%s/%s/%s/%s' "$USER_ROOT" "$host" "$ENGINE" "$ACCESS_MODE" "$repo_slug_value"
}

legacy_shared_codex_home() {
  # The pre-A1-fix shared path, kept only so doctor/usage-scanning code can
  # still find and report on old runtime dirs from before this fix. Never
  # used as an active runtime location anymore.
  local repo_slug_value host
  host="$(hostname_short)"
  repo_slug_value="$(repo_slug)"
  printf '%s/codex_runtime/%s/%s' "$USER_ROOT" "$host" "$repo_slug_value"
}

legacy_codex_home() {
  local repo host safe_name
  repo="$(pwd -P)"
  host="$(hostname_short)"
  safe_name="$(echo "$repo" | sed 's#/#__#g')"
  printf '%s/codex_runtime_danger_auto/%s/%s' "$USER_ROOT" "$host" "$safe_name"
}

current_codex_home() {
  runtime_codex_home
}

ensure_tools_layout() {
  mkdir -p \
    "$TOOLS_ROOT/base" \
    "$TOOLS_ROOT/hooks" \
    "$TOOLS_ROOT/skills" \
    "$TOOLS_ROOT/skills_approved" \
    "$TOOLS_ROOT/skills_custom" \
    "$TOOLS_ROOT/skills_quarantine" \
    "$TOOLS_ROOT/subagent_prompts" \
    "$TOOLS_ROOT/repo_graph_agent/repo_graph_agent" \
    "$TOKEN_TOOLS_ROOT"
  if [[ ! -f "$DISABLED_MCP_FRAGMENT" ]]; then
    cat > "$DISABLED_MCP_FRAGMENT" <<'EOF'
# Optional Codex MCP fragment for the local repo_graph_agent.
# Keep this disabled unless you explicitly want to wire MCP separately.
#
# Example only:
# [mcp_servers.repo_graph_agent]
# command = "/usr/bin/python3"
# args = ["-m", "repo_graph_agent", "build"]
EOF
  fi
}

backup_path() {
  local path="$1"
  if [[ -e "$path" || -L "$path" ]]; then
    local backup="${path}.bak.$(timestamp)"
    cp -a "$path" "$backup"
    printf '%s' "$backup"
  fi
}

confirm_or_die() {
  local prompt="$1"
  if [[ "$YES" -eq 1 ]]; then
    return 0
  fi
  if [[ ! -t 0 ]]; then
    echo "Refusing to modify files without confirmation in a non-interactive shell."
    exit 1
  fi
  read -r -p "$prompt [y/N] " reply
  if [[ ! "$reply" =~ ^[Yy]$ ]]; then
    echo "Cancelled."
    exit 1
  fi
}

ensure_repo_graph_pythonpath() {
  local expected="$REPO_GRAPH_PYTHONPATH"
  mkdir -p "$(dirname "$SITE_PTH")"
  if [[ -f "$SITE_PTH" ]]; then
    local current
    current="$(tr -d '\r' < "$SITE_PTH")"
    if [[ "$current" == "$expected" ]]; then
      return 0
    fi
    backup_path "$SITE_PTH" >/dev/null || true
  fi
  printf '%s\n' "$expected" > "$SITE_PTH"
}

extract_user_model_setting() {
  local key="$1"
  local config="$ACCOUNT_HOME/.codex/config.toml"
  if [[ -f "$config" ]]; then
    grep -E "^${key} = " "$config" | head -n 1 || true
  fi
}

ensure_runtime_config() {
  local repo runtime config backup model_line reasoning_line
  repo="$(repo_root)"
  runtime="$(current_codex_home)"
  config="$runtime/config.toml"
  mkdir -p "$runtime"
  if [[ -f "$config" ]]; then
    return 0
  fi
  model_line="$(extract_user_model_setting "model")"
  reasoning_line="$(extract_user_model_setting "model_reasoning_effort")"
  if [[ -z "$model_line" ]]; then
    model_line='model = "gpt-5.5"'
  fi
  if [[ -z "$reasoning_line" ]]; then
    reasoning_line='model_reasoning_effort = "xhigh"'
  fi
  cat > "$config" <<EOF
$model_line
$reasoning_line

[projects."$USER_ROOT"]
trust_level = "trusted"

[projects."$repo"]
trust_level = "trusted"
EOF
}

copy_auth_if_needed() {
  local runtime auth_src auth_dst
  runtime="$(current_codex_home)"
  auth_src="$ACCOUNT_HOME/.codex/auth.json"
  auth_dst="$runtime/auth.json"
  mkdir -p "$runtime"
  if [[ -f "$auth_src" && ! -f "$auth_dst" ]]; then
    cp -p "$auth_src" "$auth_dst"
  fi
}

ensure_runtime_agents() {
  local runtime target tmp
  runtime="$(current_codex_home)"
  target="$runtime/AGENTS.md"
  mkdir -p "$runtime"
  tmp="$(mktemp)"
  render_runtime_agents "$tmp"
  if [[ -e "$target" ]]; then
    if cmp -s "$tmp" "$target"; then
      rm -f "$tmp"
      return 0
    fi
    backup_path "$target" >/dev/null || true
  fi
  cp -p "$tmp" "$target"
  rm -f "$tmp"
}

ensure_runtime_skills() {
  local runtime skills_dir src_root
  runtime="$(current_codex_home)"
  skills_dir="$runtime/skills"
  mkdir -p "$skills_dir"
  while IFS= read -r src_root; do
    [[ -n "$src_root" ]] || continue
    cdx_link_skill_root "$src_root" "$skills_dir"
  done < <(cdx_collect_runtime_skill_roots)
}

ensure_runtime_lock() {
  local repo runtime lock
  repo="$(repo_root)"
  runtime="$(current_codex_home)"
  lock="$runtime/.codex-session.lock"
  mkdir -p "$runtime"
  exec 9>"$lock"
  if flock -n 9; then
    return 0
  fi

  if ! cdx_handle_active_session_conflict "$repo" "$runtime"; then
    return 1
  fi

  mkdir -p "$runtime"
  exec 9>"$lock"
  if flock -n 9; then
    return 0
  fi

  echo "Another Codex session is still active for this repo:"
  echo "$runtime"
  return 1
}

cdx_list_matching_session_processes() {
  local repo="${1:-}"
  local runtime_dir="${2:-}"

  if [[ -z "$repo" && -z "$runtime_dir" ]]; then
    return 0
  fi

  ps -u "$USER" -o pid=,ppid=,stat=,etime=,command= \
    | grep -Ei 'codex|cdx-agent' \
    | grep -v grep \
    | {
        if [[ -n "$repo" && -n "$runtime_dir" ]]; then
          grep -F -e "$repo" -e "$runtime_dir" || true
        elif [[ -n "$repo" ]]; then
          grep -F -e "$repo" || true
        else
          grep -F -e "$runtime_dir" || true
        fi
      } || true
}

cdx_print_active_session_diagnosis() {
  local repo="$1"
  local runtime_dir="$2"

  echo
  echo "Another Codex session is already active for this repo:"
  echo "$runtime_dir"
  echo

  echo "Repo:"
  echo "  $repo"

  echo
  echo "Runtime/session directory:"
  if [[ -d "$runtime_dir" ]]; then
    ls -ld "$runtime_dir" || true
    echo
    echo "Recent runtime files:"
    find "$runtime_dir" -maxdepth 2 -printf '%TY-%Tm-%Td %TH:%TM %p\n' 2>/dev/null \
      | sort \
      | tail -30 || true
  else
    echo "  Runtime dir does not exist anymore. This may be a stale pointer."
  fi

  echo
  echo "Matching repo/session processes:"
  local matches
  matches="$(cdx_list_matching_session_processes "$repo" "$runtime_dir" || true)"
  matches="$(printf '%s\n' "$matches" | awk -v self="$$" -v ppid="$PPID" 'NF && $1 != self && $1 != ppid')"
  if [[ -n "$matches" ]]; then
    printf '%s\n' "$matches"
  else
    echo "  No matching live Codex/cdx-agent processes found."
    echo "  This likely means the runtime directory is stale."
  fi

  echo
}

cdx_cancel_active_session() {
  local repo="$1"
  local runtime_dir="$2"
  local ts stale_dir pids remaining self_pid
  ts="$(date +%Y%m%d_%H%M%S)"
  self_pid="$$"

  echo "Cancelling active/stale Codex session for repo:"
  echo "  $repo"
  echo "Runtime:"
  echo "  $runtime_dir"
  echo

  pids="$(cdx_list_matching_session_processes "$repo" "$runtime_dir" \
    | awk -v self="$$" -v ppid="$PPID" '$1 ~ /^[0-9]+$/ && $1 != self && $1 != ppid { print $1 }' \
    | sort -u || true)"

  if [[ -n "$pids" ]]; then
    echo "Sending TERM to matching PIDs:"
    echo "$pids"
    while read -r pid; do
      [[ -n "$pid" ]] || continue
      [[ "$pid" == "$self_pid" ]] && continue
      kill -TERM "$pid" 2>/dev/null || true
    done <<EOF_PIDS
$pids
EOF_PIDS

    sleep 1

    remaining="$(cdx_list_matching_session_processes "$repo" "$runtime_dir" \
      | awk -v self="$$" -v ppid="$PPID" '$1 ~ /^[0-9]+$/ && $1 != self && $1 != ppid { print $1 }' \
      | sort -u || true)"

    if [[ -n "$remaining" ]]; then
      echo "Sending KILL to remaining matching PIDs:"
      echo "$remaining"
      while read -r pid; do
        [[ -n "$pid" ]] || continue
        [[ "$pid" == "$self_pid" ]] && continue
        kill -KILL "$pid" 2>/dev/null || true
      done <<EOF_PIDS
$remaining
EOF_PIDS
    fi
  else
    echo "No matching live processes to kill."
  fi

  if [[ -d "$runtime_dir" ]]; then
    stale_dir="${runtime_dir}.stale.${ts}"
    if [[ -e "$stale_dir" ]]; then
      stale_dir="${stale_dir}.$$"
    fi
    if ! mv "$runtime_dir" "$stale_dir"; then
      echo "Failed to move runtime dir aside:"
      echo "  $runtime_dir"
      return 1
    fi
    echo "Moved runtime dir to:"
    echo "  $stale_dir"
  else
    echo "Runtime dir already absent."
  fi
}

cdx_handle_active_session_conflict() {
  local repo="$1"
  local runtime_dir="$2"

  cdx_print_active_session_diagnosis "$repo" "$runtime_dir"

  if [[ "${CANCEL_ACTIVE:-0}" == "1" || "${CDX_CANCEL_ACTIVE:-0}" == "1" || "${CDX_CANCEL_ACTIVE_SESSION:-0}" == "1" ]]; then
    if ! cdx_cancel_active_session "$repo" "$runtime_dir"; then
      return 1
    fi
    return 0
  fi

  if [[ "${NO_CANCEL_ACTIVE:-0}" == "1" || "${CDX_NO_CANCEL_ACTIVE:-0}" == "1" ]]; then
    echo "Active-session cleanup disabled by CDX_NO_CANCEL_ACTIVE=1."
    return 1
  fi

  if [[ -t 0 ]]; then
    printf "Cancel this active/stale session and continue? [y/N] "
    local ans
    if ! read -r ans; then
      echo
      echo "No response read. Leaving active session untouched."
      return 1
    fi
    case "$ans" in
      y|Y|yes|YES|Yes)
        if ! cdx_cancel_active_session "$repo" "$runtime_dir"; then
          return 1
        fi
        return 0
        ;;
      *)
        echo "Leaving active session untouched. Exiting."
        return 1
        ;;
    esac
  else
    echo "Non-interactive shell. Not cancelling active session unless CDX_CANCEL_ACTIVE=1 is set."
    return 1
  fi
}

cdx_session_doctor() {
  local repo runtime
  repo="$(repo_root)"
  runtime="$(current_codex_home)"
  cdx_print_active_session_diagnosis "$repo" "$runtime"
}

launch_log_dir() {
  local stamp repo
  stamp="$(timestamp)"
  repo="$(repo_name | sed 's/[^A-Za-z0-9._-]/_/g')"
  printf '%s/codex_logs/%s_%s' "$USER_ROOT" "$stamp" "$repo"
}

ensure_session_log_dir() {
  if [[ -n "$CURRENT_LOGDIR" ]]; then
    printf '%s' "$CURRENT_LOGDIR"
    return 0
  fi
  CURRENT_LOGDIR="$(launch_log_dir)"
  mkdir -p "$CURRENT_LOGDIR"
  printf '%s' "$CURRENT_LOGDIR"
}

sanitize_file_stem() {
  local raw="${1:-artifact}"
  printf '%s' "$raw" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9._-]/_/g'
}

raw_output_path_for_session() {
  local stem="${1:-command}"
  local logdir
  logdir="$(ensure_session_log_dir)"
  mkdir -p "$logdir/raw_outputs"
  printf '%s/raw_outputs/%s_%s.txt' "$logdir" "$(timestamp)" "$(sanitize_file_stem "$stem")"
}

compressed_output_path_for_session() {
  local stem="${1:-command}"
  local logdir
  logdir="$(ensure_session_log_dir)"
  mkdir -p "$logdir/compressed_outputs"
  printf '%s/compressed_outputs/%s_%s.txt' "$logdir" "$(timestamp)" "$(sanitize_file_stem "$stem")"
}

write_token_saver_marker() {
  local logdir="$1"
  mkdir -p "$logdir"
  printf 'token_saver=%s\n' "$TOKEN_SAVER" > "$logdir/token_saver_enabled.txt"
  mkdir -p "$logdir/raw_outputs" "$logdir/compressed_outputs"
}

session_root_candidates() {
  {
    printf '%s\n' "$ACCOUNT_HOME/.codex"
    printf '%s\n' "$(current_codex_home)"
    printf '%s\n' "$(legacy_shared_codex_home)"
    printf '%s\n' "$(legacy_codex_home)"
    if [[ -n "${CODEX_HOME:-}" ]]; then
      printf '%s\n' "$CODEX_HOME"
    fi
  } | awk 'NF && !seen[$0]++'
}

detected_session_dirs() {
  while IFS= read -r root; do
    [[ -n "$root" ]] || continue
    [[ -d "$root/sessions" ]] && printf '%s\n' "$root/sessions"
    [[ -d "$root/archived_sessions" ]] && printf '%s\n' "$root/archived_sessions"
  done < <(session_root_candidates)
}

session_jsonl_files() {
  while IFS= read -r root; do
    [[ -d "$root" ]] || continue
    find "$root" -maxdepth 8 -type f \( \
      -path '*/sessions/*.jsonl' -o \
      -path '*/sessions/*/*.jsonl' -o \
      -path '*/sessions/*/*/*.jsonl' -o \
      -path '*/sessions/*/*/*/*.jsonl' -o \
      -path '*/archived_sessions/*.jsonl' -o \
      -name 'history.jsonl' -o \
      -name 'session_index.jsonl' \
    \) 2>/dev/null
  done < <(session_root_candidates) | sort -u
}

recent_session_jsonl_count() {
  local now count=0
  now="$(date +%s)"
  while IFS= read -r file; do
    [[ -n "$file" ]] || continue
    local mtime
    mtime="$(stat -c %Y "$file" 2>/dev/null || echo 0)"
    if (( now - mtime <= 2592000 )); then
      count=$((count + 1))
    fi
  done < <(session_jsonl_files)
  printf '%s' "$count"
}

print_recent_session_file_table() {
  local mode="${1:-mtime}"
  local now
  now="$(date +%s)"
  if [[ "$mode" == "largest" ]]; then
    while IFS= read -r file; do
      [[ -n "$file" ]] || continue
      local mtime size
      mtime="$(stat -c %Y "$file" 2>/dev/null || echo 0)"
      size="$(stat -c %s "$file" 2>/dev/null || echo 0)"
      if (( now - mtime <= 2592000 )); then
        printf '%s\t%s\n' "$size" "$file"
      fi
    done < <(session_jsonl_files) | sort -nr | head -n 10 | while IFS=$'\t' read -r size file; do
      [[ -n "$file" ]] || continue
      printf '%8s %s %s\n' "$(du -h "$file" | awk '{print $1}')" "$(date -d "@$(stat -c %Y "$file")" +%F 2>/dev/null || echo unknown)" "$file"
    done
    return 0
  fi
  while IFS= read -r file; do
    [[ -n "$file" ]] || continue
    local mtime size lines
    mtime="$(stat -c %Y "$file" 2>/dev/null || echo 0)"
    size="$(du -h "$file" 2>/dev/null | awk '{print $1}')"
    lines="$(wc -l < "$file" 2>/dev/null || echo 0)"
    printf '%s\t%s\t%s\t%s\n' "$mtime" "$size" "$lines" "$file"
  done < <(session_jsonl_files) | sort -nr | head -n 20 | while IFS=$'\t' read -r mtime size lines file; do
    printf '%8s %8s %s %s\n' "$size" "$lines" "$(date -d "@$mtime" +%F_%T 2>/dev/null || echo unknown)" "$file"
  done
}

token_tool_script() {
  printf '%s/%s' "$TOKEN_TOOLS_ROOT" "$1"
}

token_rules_present_in_file() {
  local path="$1"
  [[ -f "$path" ]] && grep -q "Token-saving rules" "$path"
}

skill_validation_summary() {
  local output
  if [[ -f "$SKILL_VALIDATOR_SCRIPT" ]]; then
    output="$(python3 "$SKILL_VALIDATOR_SCRIPT" --summary 2>/dev/null || true)"
    if [[ -n "$output" ]]; then
      printf '%s' "$output"
      return 0
    fi
  fi
  printf 'unavailable'
}

render_runtime_agents() {
  local target="$1"
  if [[ "$TOKEN_SAVER" -eq 1 ]]; then
    cp -p "$BASE_AGENTS_TEMPLATE" "$target"
    return 0
  fi
  awk '
    /<!-- TOKEN_SAVER_START -->/ {skip=1; next}
    /<!-- TOKEN_SAVER_END -->/ {skip=0; next}
    !skip {print}
  ' "$BASE_AGENTS_TEMPLATE" > "$target"
}

record_usage_snapshot() {
  local logdir="$1"
  local phase="$2"
  if have_cmd ccusage; then
    ccusage codex daily > "$logdir/usage_snapshot_${phase}.txt" 2>&1 || true
  fi
}

record_launch_metadata() {
  local logdir runtime repo sandbox approval
  logdir="$1"
  runtime="$(current_codex_home)"
  repo="$(repo_root)"
  sandbox="$2"
  approval="$3"
  mkdir -p "$logdir"
  write_token_saver_marker "$logdir"
  {
    echo "repo=$repo"
    echo "repo_name=$(repo_name)"
    echo "codex_home=$runtime"
    echo "sandbox=$sandbox"
    echo "approval=$approval"
    echo "approvals_reviewer=auto_review"
    echo "token_saver=$TOKEN_SAVER"
    echo "legacy_wrapper=$LEGACY_WRAPPER"
    echo "wrapper=$SELF_PATH"
  } > "$logdir/launch_meta.txt"
  if [[ -f "$runtime/AGENTS.md" ]]; then
    cp -p "$runtime/AGENTS.md" "$logdir/AGENTS.runtime.md"
  fi
  if [[ -f "$repo/.codex_graph/context_pack.md" ]]; then
    cp -p "$repo/.codex_graph/context_pack.md" "$logdir/context_pack.md"
  fi
  if [[ -f "$repo/.codex_graph/workspace_context_pack.md" ]]; then
    cp -p "$repo/.codex_graph/workspace_context_pack.md" "$logdir/workspace_context_pack.md"
  fi
}

write_launch_command() {
  local logdir="$1"
  shift
  printf '%q ' "$@" > "$logdir/launch_command.sh"
  printf '\n' >> "$logdir/launch_command.sh"
}

finalize_launch_log() {
  local logdir repo
  logdir="$1"
  repo="$(repo_root)"
  if git -C "$repo" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    git -C "$repo" status --short > "$logdir/git_status.short" || true
    git -C "$repo" diff --stat > "$logdir/git_diff.stat" || true
  fi
}

graph_preflight() {
  local repo graph workspace_graph
  repo="$(repo_root)"
  graph="$repo/.codex_graph/context_pack.md"
  workspace_graph="$repo/.codex_graph/workspace_context_pack.md"
  echo "PREFLIGHT repo=$repo"
  if [[ -f "$repo/AGENTS.md" ]]; then
    echo "AGENTS=present"
  else
    echo "AGENTS=missing"
  fi
  if [[ -f "$graph" ]]; then
    echo "GRAPH=present"
  else
    echo "GRAPH=missing (run: cdx-agent --graph)"
  fi
  if [[ -f "$workspace_graph" ]]; then
    echo "WORKSPACE_GRAPH=present"
  else
    echo "WORKSPACE_GRAPH=missing (run: cdx-agent --workspace-graph)"
  fi
}

run_repo_graph_build() {
  local repo="$1"
  shift || true
  PYTHONPATH="$REPO_GRAPH_PYTHONPATH${PYTHONPATH:+:$PYTHONPATH}" python3 -m repo_graph_agent build --repo "$repo" "$@"
}

run_repo_graph_context() {
  local repo="$1"
  local task="$2"
  PYTHONPATH="$REPO_GRAPH_PYTHONPATH${PYTHONPATH:+:$PYTHONPATH}" python3 -m repo_graph_agent context --repo "$repo" --task "$task"
}

run_repo_graph_detect_deps() {
  local repo="$1"
  PYTHONPATH="$REPO_GRAPH_PYTHONPATH${PYTHONPATH:+:$PYTHONPATH}" python3 -m repo_graph_agent detect-deps --repo "$repo"
}

run_repo_graph_init_workspace() {
  local repo="$1"
  if [[ "$YES" -eq 0 ]]; then
    confirm_or_die "Create workspace.yaml in $repo?"
  fi
  PYTHONPATH="$REPO_GRAPH_PYTHONPATH${PYTHONPATH:+:$PYTHONPATH}" python3 -m repo_graph_agent init-workspace --repo "$repo" --yes
}

run_repo_graph_workspace_graph() {
  local repo="$1"
  PYTHONPATH="$REPO_GRAPH_PYTHONPATH${PYTHONPATH:+:$PYTHONPATH}" python3 -m repo_graph_agent workspace-graph --repo "$repo"
}

run_repo_graph_workspace_doctor() {
  local repo="$1"
  PYTHONPATH="$REPO_GRAPH_PYTHONPATH${PYTHONPATH:+:$PYTHONPATH}" python3 -m repo_graph_agent workspace-doctor --repo "$repo"
}

default_repo_agents_content() {
  local repo_name_value="$1"
  sed "s/__REPO_NAME__/$repo_name_value/g" "$REPO_AGENTS_TEMPLATE"
}

write_repo_agents() {
  local repo target repo_base
  repo="$1"
  target="$repo/AGENTS.md"
  repo_base="$(basename "$repo")"
  if [[ -e "$target" ]]; then
    if grep -q "cdx-agent managed guidance" "$target"; then
      return 0
    fi
    backup_path "$target" >/dev/null || true
    {
      cat "$target"
      echo
      default_repo_agents_content "$repo_base"
    } > "${target}.tmp"
    mv "${target}.tmp" "$target"
    return 0
  fi
  default_repo_agents_content "$repo_base" > "$target"
}

write_repo_hooks_json() {
  local repo hooks_json
  repo="$1"
  hooks_json="$repo/.codex/hooks.json"
  mkdir -p "$repo/.codex"
  if [[ -e "$hooks_json" ]]; then
    backup_path "$hooks_json" >/dev/null || true
  fi
  cat > "$hooks_json" <<EOF
{
  "PreToolUse": [
    {
      "matcher": "Bash|Edit|Write|apply_patch",
      "hooks": [
        {
          "type": "command",
          "command": "/usr/bin/python3 \"$repo/.codex/hooks/pre_tool_use_policy.py\"",
          "timeout": 30,
          "statusMessage": "Checking command or edit safety"
        }
      ]
    }
  ],
  "PostToolUse": [
    {
      "matcher": "Bash",
      "hooks": [
        {
          "type": "command",
          "command": "/usr/bin/python3 \"$repo/.codex/hooks/post_tool_use_review.py\"",
          "timeout": 30,
          "statusMessage": "Reviewing Bash side effects"
        }
      ]
    }
  ],
  "Stop": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "/usr/bin/python3 \"$repo/.codex/hooks/stop_summary.py\"",
          "timeout": 30,
          "statusMessage": "Summarizing session changes"
        }
      ]
    }
  ]
}
EOF
}

install_repo_hooks() {
  local repo hooks_dir script src target
  repo="$1"
  hooks_dir="$repo/.codex/hooks"
  mkdir -p "$hooks_dir"
  for script in pre_tool_use_policy.py post_tool_use_review.py stop_summary.py token_risk_warn.py; do
    src="$HOOKS_ROOT/$script"
    target="$hooks_dir/$script"
    if [[ -e "$target" || -L "$target" ]]; then
      local backup
      backup_path "$target" >/dev/null || true
      rm -rf "$target"
    fi
    ln -s "$src" "$target"
  done
  write_repo_hooks_json "$repo"
}


print_doctor() {
  local repo runtime legacy user_config repo_config repo_hooks runtime_hooks
  repo="$(repo_root)"
  runtime="$(current_codex_home)"
  legacy="$(legacy_codex_home)"
  user_config="$ACCOUNT_HOME/.codex/config.toml"
  repo_config="$repo/.codex/config.toml"
  repo_hooks="$repo/.codex/hooks.json"
  runtime_hooks="$runtime/hooks.json"
  echo "codex_version=$(codex --version 2>/dev/null || true)"
  echo "cdx_agent_path=$SELF_PATH"
  echo "legacy_wrapper_path=$LEGACY_WRAPPER"
  echo "resolved_repo=$repo"
  echo "repo_name=$(repo_name)"
  echo "default_codex_home=$runtime"
  echo "legacy_codex_home=$legacy"
  echo "current_env_codex_home=${CODEX_HOME:-}"
  echo "default_sandbox=$( [[ "$ACCESS_MODE" == "safe" ]] && echo workspace-write || echo danger-full-access )"
  echo "default_approval=on-request"
  echo "default_approvals_reviewer=auto_review"
  echo "profiles=none"
  echo "global_tools_root=$TOOLS_ROOT"
  echo "repo_graph_pythonpath=$REPO_GRAPH_PYTHONPATH"
  echo "active_config_user=$user_config $( [[ -f "$user_config" ]] && echo present || echo missing )"
  echo "active_config_runtime=$runtime/config.toml $( [[ -f "$runtime/config.toml" ]] && echo present || echo missing )"
  echo "active_config_repo=$repo_config $( [[ -f "$repo_config" ]] && echo present || echo missing )"
  echo "runtime_agents=$runtime/AGENTS.md $( [[ -f "$runtime/AGENTS.md" ]] && echo present || echo missing )"
  echo "repo_agents=$repo/AGENTS.md $( [[ -f "$repo/AGENTS.md" ]] && echo present || echo missing )"
  echo "runtime_skills=$runtime/skills $( [[ -d "$runtime/skills" ]] && echo present || echo missing )"
  echo "global_skills=$TOOLS_ROOT/skills $( [[ -d "$TOOLS_ROOT/skills" ]] && echo present || echo missing )"
  echo "skills_approved=$TOOLS_ROOT/skills_approved $( [[ -d "$TOOLS_ROOT/skills_approved" ]] && echo present || echo missing )"
  echo "skills_custom=$TOOLS_ROOT/skills_custom $( [[ -d "$TOOLS_ROOT/skills_custom" ]] && echo present || echo missing )"
  echo "skills_quarantine=$TOOLS_ROOT/skills_quarantine $( [[ -d "$TOOLS_ROOT/skills_quarantine" ]] && echo present || echo missing )"
  echo "user_agents_skills=$ACCOUNT_HOME/.agents/skills $( [[ -d "$ACCOUNT_HOME/.agents/skills" ]] && echo present || echo missing )"
  echo "workspace_manifest_root=$WORKSPACE_MANIFEST_ROOT $( [[ -d "$WORKSPACE_MANIFEST_ROOT" ]] && echo present || echo missing )"
  echo "workspace_mirror_root=$WORKSPACE_MIRROR_ROOT $( [[ -d "$WORKSPACE_MIRROR_ROOT" ]] && echo present || echo missing )"
  echo "skills_validation=$(skill_validation_summary)"
  echo "runtime_hooks=$runtime_hooks $( [[ -f "$runtime_hooks" ]] && echo present || echo missing )"
  echo "repo_hooks=$repo_hooks $( [[ -f "$repo_hooks" ]] && echo present || echo missing )"
  echo "repo_graph=$repo/.codex_graph/context_pack.md $( [[ -f "$repo/.codex_graph/context_pack.md" ]] && echo present || echo missing )"
  echo "workspace_config=$repo/.codex_graph/workspace.yaml $( [[ -f "$repo/.codex_graph/workspace.yaml" ]] && echo present || echo missing )"
  echo "workspace_graph=$repo/.codex_graph/workspace_context_pack.md $( [[ -f "$repo/.codex_graph/workspace_context_pack.md" ]] && echo present || echo missing )"
  echo "pth_link=$SITE_PTH $( [[ -f "$SITE_PTH" ]] && echo present || echo missing )"
  echo "token_tools_root=$TOKEN_TOOLS_ROOT $( [[ -d "$TOKEN_TOOLS_ROOT" ]] && echo present || echo missing )"
  echo "token_saver_default=off"
  # Codex binary/symlink, CLI version vs installed releases, configured + offload model in
  # models_cache.json. Local files only: no network, never runs `codex update`.
  cdx_agent_mod offload --doctor 2>&1 || echo "codex_checks=FAILED (python3 -m cdx_agent.offload --doctor)"
}

print_token_doctor() {
  local repo runtime repo_hooks runtime_hooks runtime_agents
  repo="$(repo_root)"
  runtime="$(current_codex_home)"
  repo_hooks="$repo/.codex/hooks.json"
  runtime_hooks="$runtime/hooks.json"
  runtime_agents="$runtime/AGENTS.md"
  echo "rtk=$(have_cmd rtk && command -v rtk || echo missing)"
  echo "ccusage=$(have_cmd ccusage && command -v ccusage || echo missing)"
  echo "tokscale=$(have_cmd tokscale && command -v tokscale || echo missing)"
  echo "repo=$repo"
  echo "codex_home=$runtime"
  echo "context_pack=$( [[ -f "$repo/.codex_graph/context_pack.md" ]] && echo present || echo missing )"
  echo "skills_validation=$(skill_validation_summary)"
  echo "base_agents_token_rules=$(token_rules_present_in_file "$BASE_AGENTS_TEMPLATE" && echo present || echo missing)"
  echo "runtime_agents_token_rules=$(token_rules_present_in_file "$runtime_agents" && echo present || echo missing)"
  echo "repo_hooks_token_warnings=$( [[ -f "$repo_hooks" ]] && grep -Eq 'pre_tool_use_policy.py|token_risk_warn.py' "$repo_hooks" && echo present || echo missing )"
  echo "runtime_hooks_token_warnings=$( [[ -f "$runtime_hooks" ]] && grep -Eq 'pre_tool_use_policy.py|token_risk_warn.py' "$runtime_hooks" && echo present || echo missing )"
  echo
  echo "detected_session_dirs"
  detected_session_dirs | sed 's/^/- /' || true
  echo
  echo "recent_session_jsonl_count_30d=$(recent_session_jsonl_count)"
  echo "largest_recent_session_files"
  if ! print_recent_session_file_table largest | sed 's/^/- /'; then
    echo "- none"
  fi
  echo
  echo "likely_token_risk_folders"
  find "$repo" -maxdepth 3 -type d \( \
    -name logs -o -name outputs -o -name checkpoints -o -name ckpts -o -name wandb -o -name runs -o \
    -name data -o -name datasets -o -name videos -o -name media -o -name __pycache__ -o -name .git \
  \) 2>/dev/null | sed 's/^/- /' || true
}

tool_install_command() {
  local tool="$1"
  case "$tool" in
    rtk)
      if have_cmd cargo; then
        printf 'cargo install --root %q --git https://github.com/rtk-ai/rtk' "$ACCOUNT_HOME/.local"
      elif have_cmd curl; then
        printf 'curl -fsSL https://raw.githubusercontent.com/rtk-ai/rtk/refs/heads/master/install.sh | sh'
      fi
      ;;
    ccusage)
      if have_cmd npm; then
        printf 'npm install --prefix %q ccusage' "$ACCOUNT_HOME/.local"
      elif have_cmd bun; then
        printf 'bun install -g ccusage'
      elif have_cmd pnpm; then
        printf 'pnpm add -g ccusage'
      fi
      ;;
    tokscale)
      if have_cmd npm; then
        printf 'npm install --prefix %q tokscale' "$ACCOUNT_HOME/.local"
      elif have_cmd bun; then
        printf 'bun install -g tokscale'
      elif have_cmd pnpm; then
        printf 'pnpm add -g tokscale'
      fi
      ;;
  esac
}

install_one_token_tool() {
  local tool="$1"
  local cmd
  if have_cmd "$tool"; then
    echo "$tool already installed at $(command -v "$tool")"
    return 0
  fi
  cmd="$(tool_install_command "$tool")"
  if [[ -z "$cmd" ]]; then
    echo "$tool install skipped: no supported package manager detected."
    return 0
  fi
  echo "install_command[$tool]=$cmd"
  if [[ "$YES" -eq 0 ]]; then
    confirm_or_die "Install $tool using the command above?"
  fi
  bash -lc "$cmd"
}

install_token_tools() {
  ensure_tools_layout
  echo "rtk_status=$(have_cmd rtk && echo installed || echo missing)"
  install_one_token_tool rtk
  echo
  echo "ccusage_status=$(have_cmd ccusage && echo installed || echo missing)"
  install_one_token_tool ccusage
  echo
  echo "tokscale_status=$(have_cmd tokscale && echo installed || echo missing)"
  install_one_token_tool tokscale
}

run_validate_skills() {
  if [[ ! -f "$SKILL_VALIDATOR_SCRIPT" ]]; then
    echo "Skill validator missing: $SKILL_VALIDATOR_SCRIPT" >&2
    exit 1
  fi
  python3 "$SKILL_VALIDATOR_SCRIPT"
}

run_skills_list() {
  if [[ ! -f "$SKILL_VALIDATOR_SCRIPT" ]]; then
    echo "Skill validator missing: $SKILL_VALIDATOR_SCRIPT" >&2
    exit 1
  fi
  python3 "$SKILL_VALIDATOR_SCRIPT" --list
}

run_skills_audit() {
  if [[ ! -f "$SKILL_VALIDATOR_SCRIPT" ]]; then
    echo "Skill validator missing: $SKILL_VALIDATOR_SCRIPT" >&2
    exit 1
  fi
  python3 "$SKILL_VALIDATOR_SCRIPT" --audit
}

should_use_rtk_for_command() {
  local first="${1:-}"
  case "$first" in
    git|rg|grep|ls|tree|pytest|cargo|npm|pnpm|bun|python|python3)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

run_with_rtk_if_available() {
  if have_cmd rtk && should_use_rtk_for_command "$@"; then
    rtk "$@"
  else
    "$@"
  fi
}

run_and_capture_raw() {
  local raw_file="$1"
  shift
  "$@" >"$raw_file" 2>&1
}

small_targeted_read_should_stay_raw() {
  local raw_file="$1"
  shift
  local line_count first
  line_count="$(wc -l < "$raw_file" 2>/dev/null || echo 0)"
  first="${1:-}"
  if (( line_count > 200 )); then
    return 1
  fi
  case "$first" in
    sed|cat|head|tail)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

summarize_raw_output() {
  local raw_file="$1"
  local summary_file="$2"
  local command_text="$3"
  local exit_code="$4"
  shift 4
  if small_targeted_read_should_stay_raw "$raw_file" "$@"; then
    cp -p "$raw_file" "$summary_file"
    return 0
  fi
  python3 "$(token_tool_script summarize_output.py)" \
    --input "$raw_file" \
    --command "$command_text" \
    --exit-code "$exit_code" \
    > "$summary_file"
}

run_usage_grouped_fallback() {
  local fmt="$1"
  local label="$2"
  local runtime files
  runtime="$(current_codex_home)"
  files="$(session_jsonl_files || true)"
  echo "ccusage unavailable; fallback $label report based on local session file mtimes."
  while IFS= read -r file; do
    [[ -n "$file" ]] || continue
    date -d "@$(stat -c %Y "$file" 2>/dev/null || echo 0)" +"$fmt" 2>/dev/null || true
  done <<< "$files" | sort | uniq -c
  if [[ -z "$files" ]]; then
    echo "No session JSONL files detected under current Codex roots."
  fi
  echo "CODEX_HOME=$runtime"
}

run_usage_session_fallback() {
  local runtime
  runtime="$(current_codex_home)"
  echo "ccusage unavailable or unsupported; fallback session file report."
  print_recent_session_file_table mtime || true
  echo "CODEX_HOME=$runtime"
}

run_usage_daily() {
  if have_cmd ccusage; then
    ccusage codex daily && return 0
    echo "ccusage codex daily failed; falling back."
  else
    echo "ccusage is not installed. Suggestion: cdx-agent --install-token-tools"
  fi
  run_usage_grouped_fallback "%F" "daily"
}

run_usage_month() {
  if have_cmd ccusage; then
    ccusage codex monthly && return 0
    echo "ccusage codex monthly failed; falling back."
  else
    echo "ccusage is not installed. Suggestion: cdx-agent --install-token-tools"
  fi
  run_usage_grouped_fallback "%Y-%m" "monthly"
}

run_usage_session() {
  if have_cmd ccusage; then
    ccusage codex session && return 0
    echo "ccusage codex session failed; falling back."
  else
    echo "ccusage is not installed. Suggestion: cdx-agent --install-token-tools"
  fi
  run_usage_session_fallback
}

run_context_budget() {
  local repo logdir report
  repo="$(guarded_graph_target_dir)"
  logdir="$(ensure_session_log_dir)"
  report="$logdir/context_budget.txt"
  python3 "$(token_tool_script context_budget.py)" --repo "$repo" | tee "$report"
  echo "context_budget_log=$report"
}

run_summarize_log() {
  local log_file summary_file logdir
  if [[ -z "$TARGET_LOG_FILE" ]]; then
    echo "Missing log file for --summarize-log"
    exit 1
  fi
  log_file="$(readlink -f "$TARGET_LOG_FILE")"
  if [[ ! -f "$log_file" ]]; then
    echo "Log file not found: $TARGET_LOG_FILE"
    exit 1
  fi
  logdir="$(ensure_session_log_dir)"
  summary_file="$(compressed_output_path_for_session "$(basename "$log_file")")"
  python3 "$(token_tool_script summarize_log.py)" --input "$log_file" | tee "$summary_file"
  echo "summary_output=$summary_file"
}

run_compress_output() {
  local raw_file summary_file command_text exit_code logdir
  if [[ "${#COMPRESS_COMMAND[@]}" -eq 0 ]]; then
    echo "Missing command for --compress-output"
    exit 1
  fi
  logdir="$(ensure_session_log_dir)"
  raw_file="$(raw_output_path_for_session "${COMPRESS_COMMAND[0]}")"
  summary_file="$(compressed_output_path_for_session "${COMPRESS_COMMAND[0]}")"
  printf -v command_text '%q ' "${COMPRESS_COMMAND[@]}"
  if run_and_capture_raw "$raw_file" run_with_rtk_if_available "${COMPRESS_COMMAND[@]}"; then
    exit_code=0
  else
    exit_code=$?
  fi
  summarize_raw_output "$raw_file" "$summary_file" "$command_text" "$exit_code" "${COMPRESS_COMMAND[@]}"
  cat "$summary_file"
  echo
  echo "raw_output=$raw_file"
  echo "summary_output=$summary_file"
  echo "exit_code=$exit_code"
  if [[ "$exit_code" -ne 0 ]]; then
    echo "Rerun without compression if needed: cdx-agent --no-token-saver ${command_text}"
  fi
  return "$exit_code"
}

review_repo() {
  local repo logdir files dangerous=0
  repo="$(repo_root)"
  logdir="$(launch_log_dir)"
  mkdir -p "$logdir"
  echo "repo=$repo"
  if ! git -C "$repo" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    echo "Not a git repo."
    return 0
  fi
  echo
  echo "git diff --stat"
  git -C "$repo" diff --stat || true
  echo
  echo "changed files"
  git -C "$repo" status --short || true
  echo
  echo "dangerous changes"
  while IFS= read -r file; do
    [[ -n "$file" ]] || continue
    if [[ "$file" =~ (^|/)(checkpoints?|datasets?|data|logs|wandb|outputs)(/|$) ]] || [[ "$file" =~ \.(pt|pth|ckpt|safetensors|bin|h5|parquet)$ ]]; then
      echo "WARN data/artifact path: $file"
      dangerous=1
    elif [[ "$file" =~ (^|/)(policies|runtime|env|training)(/|$) ]]; then
      echo "WARN core runtime/training path: $file"
      dangerous=1
    fi
  done < <(git -C "$repo" diff --name-only && git -C "$repo" diff --cached --name-only)
  if [[ "$dangerous" -eq 0 ]]; then
    echo "No obvious dangerous changes found."
  fi
  git -C "$repo" diff --stat > "$logdir/git_diff.stat" || true
  git -C "$repo" status --short > "$logdir/git_status.short" || true
  echo "review_log_dir=$logdir"
}

# Run a cdx_agent Python CLI subcommand, e.g. `cdx_agent_py session-doctor --repo .`
cdx_agent_py() {
  PYTHONPATH="$CDX_AGENT_PYTHONPATH" python3 -m cdx_agent "$@"
}

# Run one standalone cdx_agent module, e.g. `cdx_agent_mod offload --doctor`
# (offload, notify, move_verify, gpu_lock, brief; each has its own --help).
cdx_agent_mod() {
  local mod="$1"
  shift
  PYTHONPATH="$CDX_AGENT_PYTHONPATH" python3 -m "cdx_agent.$mod" "$@"
}

launch_codex() {
  # Delegates to the cdx_agent Python package for everything that matters
  # safety-wise: runtime provisioning (isolated per engine+access-mode, A1
  # fix), session locking/cancellation (PID-verified, A3 fix), skills linking
  # (enforced audit gate, A4 fix), and hooks/doc generation (A6/D2/D3 fixes).
  # Bash keeps only the session-log-directory bookkeeping it already owned
  # (codex_logs/<ts>_<repo>/launch_meta.txt, usage snapshots, git status
  # capture) until that gets ported too. See docs/migration.md in the
  # CDX-AGENT repo for the full parity tracking.
  local repo access_flag logdir status
  repo="$(repo_root)"
  access_flag="--safe"
  [[ "$ACCESS_MODE" == "full" ]] && access_flag="--full"

  graph_preflight

  logdir="$(ensure_session_log_dir)"
  record_launch_metadata "$logdir" \
    "$([[ "$ACCESS_MODE" == "full" ]] && printf 'danger-full-access' || printf 'workspace-write')" \
    "on-request"
  record_usage_snapshot "$logdir" before

  local -a python_args=(launch --repo "$repo" --engine "$ENGINE" "$access_flag")
  [[ "$DRY_RUN" -eq 1 ]] && python_args+=(--dry-run)
  [[ "$TOKEN_SAVER" -eq 1 ]] && python_args+=(--token-saver)
  if [[ "$TAKEOVER" -eq 1 ]]; then
    python_args+=(--takeover)
  elif [[ "$CANCEL_ACTIVE" -eq 1 ]]; then
    python_args+=(--cancel-active)
  elif [[ "$SECONDARY" -eq 1 ]]; then
    python_args+=(--secondary)
  fi
  [[ "$DRAIN_SECONDS" != "0" ]] && python_args+=(--drain "$DRAIN_SECONDS")

  write_launch_command "$logdir" python3 -m cdx_agent "${python_args[@]}" -- "${PASSTHROUGH[@]}"

  echo "MODE=$ACCESS_MODE"
  echo "ENGINE=$ENGINE"
  echo "REPO=$repo"
  echo "LOGDIR=$logdir"
  echo

  set +e
  cdx_agent_py "${python_args[@]}" -- "${PASSTHROUGH[@]}"
  status=$?
  set -e
  record_usage_snapshot "$logdir" after
  finalize_launch_log "$logdir"
  return "$status"
}

run_init_repo() {
  local repo
  repo="$(repo_root)"
  confirm_or_die "Initialize repo-local Codex files in $repo?"
  mkdir -p "$repo/.codex"
  write_repo_agents "$repo"
  install_repo_hooks "$repo"
  run_repo_graph_build "$repo"
  echo "Initialized repo Codex scaffolding in $repo"
}

run_graph_only() {
  local repo
  repo="$(guarded_graph_target_dir)"
  run_repo_graph_build "$repo"
}

run_install_hooks() {
  local repo runtime
  repo="$(repo_root)"
  runtime="$(current_codex_home)"
  case "$INSTALL_TARGET" in
    auto)
      if is_git_repo; then
        confirm_or_die "Install repo-local hooks in $repo/.codex?"
        install_repo_hooks "$repo"
      else
        install_runtime_hooks
      fi
      ;;
    repo)
      confirm_or_die "Install repo-local hooks in $repo/.codex?"
      install_repo_hooks "$repo"
      ;;
    runtime)
      install_runtime_hooks
      ;;
    *)
      echo "Unknown install target: $INSTALL_TARGET"
      exit 1
    ;;
  esac
}

print_usage() {
  cat <<'EOF'
Usage:
  cdx-agent [options] [--] [codex args...]

Modes:
  --doctor              Print wrapper/runtime diagnostics.
  --session-doctor      Diagnose active/stale Codex session state for the
                        current repo without killing anything.
  --token-doctor        Inspect token tools, sessions, and token-risk hints.
  --validate-skills     Validate discovered SKILL.md files across user, runtime,
                        repo-local, and managed skill roots.
  --skills-list         List discovered skills with roots, names, and descriptions.
  --skills-audit        Scan discovered skills for risky instructions and commands.
  --init-tools          Create or verify the local Codex tools layout.
  --init-repo           Initialize repo-local Codex scaffolding.
  --init-workspace      Create workspace.yaml through repo_graph_agent.
  --detect-deps         Run repo dependency detection for the target repo.
  --graph               Build .codex_graph/context_pack.md for the target repo.
  --workspace-graph     Build the workspace-level graph pack.
  --workspace-doctor    Inspect workspace graph/config status.
  --review              Show git diff/status plus risky-path warnings.
  --usage               Show daily token usage.
  --usage-session       Show session token usage.
  --usage-month         Show monthly token usage.
  --install-token-tools Install rtk, ccusage, and tokscale if available.
  --install-hooks       Install repo-local or runtime hooks.
  --context-budget      Print a token/context budget report for the repo.
  --compress-output     Run the remaining argv as a command, capture it,
                        and summarize the output.
  --summarize-log FILE  Summarize an existing log file.

Helpers (each consumes the rest of argv; `cdx-agent --<helper> --help` for details):
  --offload [--repo DIR] [--timeout S] [--raw] "<prompt>"   (prompt may also come on stdin)
                        Non-interactive Codex reasoning offload: codex exec -m gpt-5.6-luna
                        --sandbox read-only --skip-git-repo-check -C DIR. The model is
                        pinned (no fallback); prints only the final answer (--raw: all).
  --notify EVENTS.jsonl [--routine REGEX_FILE] [--settle S] [--stale S]
           [--done-kinds END,EMPTY] [--alive FILE] [--then "CMD"]
                        One-shot notifier over another logger's JSONL log, from its
                        current end (read-only). Exits on the first event whose
                        "KIND text" matches no routine regex, SETTLE s after the first
                        done-kind event, or when EVENTS.alive is older than STALE s;
                        then runs --then CMD and prints its output.
  --hygiene [--repo P] [--memory-max-bytes N] [--memory-max-files N]   read-only: removable/outside worktrees, memory size
  --move-verify SRC DST [--bwlimit KBPS] [--no-lsof] [--verify-only]
                        ionice/nice rsync -a SRC/ DST/, then verify (rsync --checksum
                        dry-run lists nothing + equal file counts/byte totals). Prints
                        VERIFIED and the exact `! rm -rf SRC && ln -s DST SRC` line for
                        the USER. Never deletes anything.
  --hash-repro --want sha256:<hex|prefix> [--timeout S] [--log FILE.jsonl] -- CMD...
                        Runs a metadata-only identity command (CPU-only: CUDA hidden, 2 threads,
                        nice 15, timeout default 1800 s), collects every sha256:<hex> it prints
                        and passes only if one starts with --want. One line: hash-repro PASS|FAIL.
  --teardown SPEC.json [--out SCRIPT.sh]
                        Generates (does not run) a dry-run-by-default stop script from a spec
                        (name, tmux_session, groups, expect, busy_ports, keep_listening, log,
                        after_cmd): identity checks, port checks, CONFIRM=1 kills windows group
                        by group (never kill-session), JSONL log. Default out: stop_<name>.sh.
  --coldbank list|put|fetch|run|release|cat|status|gc|verify ...
                        westeros cold bank (big store) + per-host size-budgeted caches:
                        `fetch NAME` copies + sha256-verifies on demand (LRU eviction of
                        unleased cache copies), `run NAME -- CMD` leases it for CMD.
                        Design: CDX-AGENT/docs/coldbank.md.
  --gpu-lock HOLD_JOBID [--n K | --gpu G[,G2]] [--eta MIN] [--host rlab1] [--gres G] [--mem M]
             [--dry-run] -- CMD...
                        Run CMD as `ssh HOST srun --jobid=HOLD --overlap ...` inside a
                        shared GPU hold: takes K free flock locks in
                        /freespace/local/ss5772/gpu_locks/gpu<G>.lock, writes gpu<G>.owner,
                        exports CUDA_VISIBLE_DEVICES, releases on exit. NFS guard: the
                        wrapper and a shell-script CMD are snapshotted to node-local disk
                        and the copies run (an NFS script edited mid-run dies with
                        "Stale file handle"); --no-snapshot skips. --dry-run prints srun.
  --gpu-lock --status [--node NODE]
                        List GPU lock holders and owner files (default node rlab2).
  --brief <WORKTREE|BRANCH> [--base B] [--max-tokens 3000] [--rules FILE]
                        Deterministic no-LLM context brief to seed a FRESH subagent/Codex
                        worker (instead of forking/resuming a long session): branch, HEAD,
                        base + merge-base, commits, changed files, TODO/Open/Next of changed
                        docs/runbooks + docs/status/*todo*, changed reports/** headlines,
                        base/brief_rules.md, output contract. Capped at ~4 chars/token.

GrapeRoot / Dual-Graph:
  --cpu-job [--node N] [--threads 8] [--mem 16G] [--time 2:00:00] [--wait] [--dry-run] -- CMD
                        Run CPU-heavy work (tests, replays, data generation) on the ilab node (not rlab) with the
                        most idle CPUs (sinfo), thread limits set; sbatch by default (prints job/node/log),
                        --wait = srun in the foreground with --timeout. Use when a workstation is loaded. Refuses (prints the niced
                        local background command) when repo data symlinks / command paths resolve under /data/local (--allow-local-data).
  --watch [--job ID[:NAME]] [--tmux NAME[:LOG[:DONE_RE[:FAIL_RE]]]] [--log NAME:PATH:DONE_RE[:FAIL_RE]] [--spec F.json] --out-dir D
                        ONE background watcher for many runs: status.md/status.jsonl, Codex summary per finished item
                        (spec "summary"), exits once: 0 all done / 2 first failure / 3 timeout. Run it with run_in_background.
  --agent-usage [--tasks-dir D] [--active-only] [--json]
                        Per Claude subagent: tokens (incl. cache reads), transcript MB, last action, WAITING/IDLE/BIG flags.
  --gpu-pick --gpu-type a4000[,4500_ada] [--n 1] [--cap 8] [--per-node-clients 4] [--shared-clients 2] [--mem 60G] [--cpus 1] [--min-disk-gb 50]
                        Node a job can really start on (free GPUs within the user cap (GrpTRES gpu=8, node=1: all running jobs must share ONE node) = RUNNING jobs only, free RAM >= --mem,
                        free CPUs >= --cpus, not PLANNED/DRAIN/DOWN/RESERVED, Isaac client limit, node-local disk) -> sbatch
                        options incl. --mem; one line per rejected node.
  --gpu-pick --status [--mem 60G] [--workstations westeros,arrakis]
                        Inventory: per Slurm node GPUs / CPUs / RAM free and whether a job can start (else why), our running/
                        pending/held GPUs vs the cap, and the workstations' nvidia-smi with process owners.
  --handoff [--repo DIR] [--out FILE] [--base main] [--branches GLOB] [--since-hours 24] [--notes FILE]
            [--slurm-host HOST] [--no-slurm] [--no-gpu] [--max-tokens 4000]
                        Deterministic machine-written handoff (worktrees, Slurm jobs, GPUs, tmux names,
                        report headlines, open items, agent notes, resume line) to restart a long main
                        session fresh at a breakpoint. Default out: docs/status/<date>_handoff_auto.md.
                        Slurm via squeue, else ssh $CDX_SLURM_HOST (default rlab1).
  --dg [prompt...]                  Launch Codex through GrapeRoot/Dual-Graph on
                                    the current repo root.
  --graperoot [prompt...]           Alias for --dg.
  --dg-root PATH [prompt...]        Launch GrapeRoot/Dual-Graph on an explicit
                                    root directory.
  --graperoot-root PATH [prompt...] Alias for --dg-root.
  --dg-workspace NAME|MANIFEST [prompt...]
                                    Launch Codex through a symlink mirror
                                    workspace.
  --dg-workspace-init NAME PATH... [--force]
                                    Create or overwrite a multi-folder workspace
                                    manifest.
  --dg-workspace-list               List configured workspace manifests.
  --dg-workspace-show NAME|MANIFEST  Show resolved workspace paths.
  --dg-workspace-clean NAME|MANIFEST Remove only the generated mirror directory.

Skills:
  --validate-skills                 Validate SKILL.md metadata and warnings.
  --skills-list                     List discovered skills and their roots.
  --skills-audit                    Audit discovered skills for risky patterns.

Wrapper flags:
  --safe                Launch Codex with workspace-write sandbox.
  --full                Launch Codex with danger-full-access sandbox.
  --token-saver         Enable token-saving wrapper behavior.
  --no-token-saver      Disable token-saving wrapper behavior.
  --repo PATH           Target PATH for graph/context operations.
  --force-home-scan     Allow graph scanning the home directory.
  --repo-local          Force --install-hooks to use repo-local hooks.
  --runtime             Force --install-hooks to use runtime hooks.
  --yes                 Skip confirmation prompts used by init/install modes,
                        including --init-repo --yes.
  --dry-run             Print the Codex command without executing it.
  -h, --help            Show this help and exit.

Session cleanup:
  --cancel-active       If this repo has an active/stale Codex session, kill
                        matching repo/session processes, move the runtime
                        aside, and continue
  --no-cancel-active    Do not prompt for active-session cleanup; exit on
                        conflict
  --takeover            Claude: cancel the active session, then relaunch
                        with --resume <that session>, so the conversation
                        carries over; interrupted background agents can be
                        resumed from it by messaging their ids. (Background
                        agents/shells live inside the session process, so
                        any cancel stops them; transcripts are kept.)
  --drain SECONDS       With --cancel-active/--takeover: first wait up to
                        SECONDS for the old session's background agents and
                        shells to stop writing output (default 0)

Behavior:
  - Default mode is launch: it prepares the repo/runtime layout and runs codex.
  - Unrecognized arguments are forwarded to codex after wrapper parsing.
    This includes codex subcommands such as resume.
  - --compress-output consumes the rest of argv as the wrapped command.
  - --offload, --notify, --move-verify, --gpu-lock, --brief, --handoff, --cpu-job, --watch, --agent-usage, --gpu-pick, --coldbank, --hash-repro and --teardown also consume the rest of argv.
  - GrapeRoot modes honor --dry-run or CDX_DRY_RUN=1.
  - --token-saver can be combined with --full or --safe.
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --doctor)
      MODE="doctor"
      shift
      ;;
    --token-doctor)
      MODE="token-doctor"
      shift
      ;;
    --validate-skills)
      MODE="validate-skills"
      shift
      ;;
    --skills-list)
      MODE="skills-list"
      shift
      ;;
    --skills-audit)
      MODE="skills-audit"
      shift
      ;;
    --init-tools)
      MODE="init-tools"
      shift
      ;;
    --init-repo)
      MODE="init-repo"
      shift
      ;;
    --session-doctor)
      MODE="session-doctor"
      shift
      ;;
    --dg)
      MODE="dg"
      shift
      ;;
    --graperoot)
      MODE="graperoot"
      shift
      ;;
    --dg-root)
      MODE="dg-root"
      shift
      DG_ROOT_OVERRIDE="${1:-}"
      if [[ -z "$DG_ROOT_OVERRIDE" ]]; then
        echo "Missing path for --dg-root" >&2
        exit 1
      fi
      shift
      ;;
    --graperoot-root)
      MODE="graperoot-root"
      shift
      DG_ROOT_OVERRIDE="${1:-}"
      if [[ -z "$DG_ROOT_OVERRIDE" ]]; then
        echo "Missing path for --graperoot-root" >&2
        exit 1
      fi
      shift
      ;;
    --dg-workspace)
      MODE="dg-workspace"
      shift
      DG_WORKSPACE_SPEC="${1:-}"
      if [[ -z "$DG_WORKSPACE_SPEC" ]]; then
        echo "Missing workspace spec for --dg-workspace" >&2
        exit 1
      fi
      shift
      ;;
    --dg-workspace-init)
      MODE="dg-workspace-init"
      shift
      DG_WORKSPACE_INIT_NAME="${1:-}"
      if [[ -z "$DG_WORKSPACE_INIT_NAME" ]]; then
        echo "Missing workspace name for --dg-workspace-init" >&2
        exit 1
      fi
      shift
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --force)
            DG_WORKSPACE_FORCE=1
            ;;
          --dry-run)
            DRY_RUN=1
            ;;
          *)
            DG_WORKSPACE_INIT_PATHS+=("$1")
            ;;
        esac
        shift
      done
      break
      ;;
    --dg-workspace-list)
      MODE="dg-workspace-list"
      shift
      ;;
    --dg-workspace-show)
      MODE="dg-workspace-show"
      shift
      DG_WORKSPACE_SPEC="${1:-}"
      if [[ -z "$DG_WORKSPACE_SPEC" ]]; then
        echo "Missing workspace spec for --dg-workspace-show" >&2
        exit 1
      fi
      shift
      ;;
    --dg-workspace-clean)
      MODE="dg-workspace-clean"
      shift
      DG_WORKSPACE_SPEC="${1:-}"
      if [[ -z "$DG_WORKSPACE_SPEC" ]]; then
        echo "Missing workspace spec for --dg-workspace-clean" >&2
        exit 1
      fi
      shift
      ;;
    --detect-deps)
      MODE="detect-deps"
      shift
      ;;
    --init-workspace)
      MODE="init-workspace"
      shift
      ;;
    --graph)
      MODE="graph"
      shift
      ;;
    --workspace-graph)
      MODE="workspace-graph"
      shift
      ;;
    --workspace-doctor)
      MODE="workspace-doctor"
      shift
      ;;
    --review)
      MODE="review"
      shift
      ;;
    --usage)
      MODE="usage"
      shift
      ;;
    --usage-session)
      MODE="usage-session"
      shift
      ;;
    --usage-month)
      MODE="usage-month"
      shift
      ;;
    --install-token-tools)
      MODE="install-token-tools"
      shift
      ;;
    --compress-output)
      MODE="compress-output"
      shift
      COMPRESS_COMMAND=("$@")
      break
      ;;
    --offload|--notify|--move-verify|--gpu-lock|--brief|--handoff|--cpu-job|--watch|--agent-usage|--gpu-pick|--coldbank|--hash-repro|--teardown|--hygiene|--deploy|--value|--rm|--trash|--inuse)
      MODE="${1#--}"
      shift
      MODULE_ARGS=("$@")
      break
      ;;
    --summarize-log)
      MODE="summarize-log"
      shift
      TARGET_LOG_FILE="${1:-}"
      [[ $# -gt 0 ]] && shift || true
      ;;
    --context-budget)
      MODE="context-budget"
      shift
      ;;
    --install-hooks)
      MODE="install-hooks"
      shift
      ;;
    --token-saver)
      TOKEN_SAVER=1
      shift
      ;;
    --no-token-saver)
      TOKEN_SAVER=0
      shift
      ;;
    --cancel-active)
      CANCEL_ACTIVE=1
      NO_CANCEL_ACTIVE=0
      shift
      ;;
    --no-cancel-active)
      NO_CANCEL_ACTIVE=1
      CANCEL_ACTIVE=0
      TAKEOVER=0
      shift
      ;;
    --takeover)
      TAKEOVER=1
      NO_CANCEL_ACTIVE=0
      shift
      ;;
    --drain)
      [[ $# -ge 2 ]] || { echo "--drain needs SECONDS" >&2; exit 2; }
      DRAIN_SECONDS="$2"
      shift 2
      ;;
    --drain=*)
      DRAIN_SECONDS="${1#--drain=}"
      shift
      ;;
    --safe)
      ACCESS_MODE="safe"
      shift
      ;;
    --full)
      ACCESS_MODE="full"
      shift
      ;;
    --claude)
      ENGINE="claude"
      shift
      ;;
    --codex)
      ENGINE="codex"
      shift
      ;;
    --secondary)
      SECONDARY=1
      shift
      ;;
    --repo)
      shift
      TARGET_REPO="${1:-}"
      if [[ -z "$TARGET_REPO" ]]; then
        echo "Missing path for --repo" >&2
        exit 1
      fi
      shift
      ;;
    --force-home-scan)
      FORCE_HOME_SCAN=1
      shift
      ;;
    --repo-local)
      INSTALL_TARGET="repo"
      shift
      ;;
    --runtime)
      INSTALL_TARGET="runtime"
      shift
      ;;
    --yes)
      YES=1
      shift
      ;;
    --dry-run)
      DRY_RUN=1
      shift
      ;;
    -h|--help)
      MODE="help"
      shift
      break
      ;;
    *)
      PASSTHROUGH+=("$1")
      shift
      ;;
  esac
done

run_hash_repro() {
  local want="" tmo=1800 log="" cmd=() a
  set -- "${MODULE_ARGS[@]}"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --want) want="${2:-}"; shift 2 ;;
      --timeout) tmo="${2:-}"; shift 2 ;;
      --log) log="${2:-}"; shift 2 ;;
      --) shift; cmd=("$@"); break ;;
      *) echo "hash-repro: unknown argument $1 (use -- before the command)" >&2; exit 2 ;;
    esac
  done
  [[ -n "$want" && ${#cmd[@]} -gt 0 ]] || { echo "usage: cdx-agent --hash-repro --want sha256:<hex|prefix> [--timeout S] [--log FILE.jsonl] -- <command...>" >&2; exit 2; }
  local out rc
  out="$(mktemp "${TMPDIR:-/tmp}/hash_repro.XXXXXX")"
  CUDA_VISIBLE_DEVICES="" OMP_NUM_THREADS=2 MKL_NUM_THREADS=2 OPENBLAS_NUM_THREADS=2 NUMEXPR_NUM_THREADS=2 \
    PYTHONDONTWRITEBYTECODE=1 nice -n 15 timeout "$tmo" "${cmd[@]}" >"$out" 2>&1 && rc=0 || rc=$?
  python3 - "$want" "$rc" "$out" "$log" "${cmd[@]}" <<'PY'
import sys, re, json, time
want, rc, out, log = sys.argv[1], int(sys.argv[2]), sys.argv[3], sys.argv[4]
cmd = sys.argv[5:]
txt = open(out, errors="replace").read()
got = []
for h in re.findall(r"sha256:[0-9a-fA-F]{8,64}", txt):
    h = h.lower()
    if h not in got:
        got.append(h)
w = want.lower()
if not w.startswith("sha256:"):
    w = "sha256:" + w
ok = any(h.startswith(w) for h in got)
print("hash-repro %s want=%s got=%s exit=%d log=%s" % ("PASS" if ok else "FAIL", want, ",".join(got) or "-", rc, out))
if log:
    with open(log, "a") as f:
        f.write(json.dumps({"t": time.strftime("%Y-%m-%dT%H:%M:%S%z"), "want": want, "got": got, "pass": ok,
                            "cmd": cmd, "exit": rc, "out": out}) + "\n")
sys.exit(0 if ok else 1)
PY
}

run_teardown() {
  local spec="${MODULE_ARGS[0]:-}" outp="" i
  [[ -n "$spec" && -f "$spec" ]] || { echo "usage: cdx-agent --teardown SPEC.json [--out SCRIPT.sh]" >&2; exit 2; }
  for ((i = 1; i < ${#MODULE_ARGS[@]}; i++)); do
    case "${MODULE_ARGS[i]}" in
      --out) outp="${MODULE_ARGS[i+1]:-}"; i=$((i+1)) ;;
      *) echo "teardown: unknown argument ${MODULE_ARGS[i]}" >&2; exit 2 ;;
    esac
  done
  python3 - "$spec" "$outp" <<'PY'
import sys, json, os, shlex, stat
spec_path, outp = sys.argv[1], sys.argv[2]
s = json.load(open(spec_path))
name = s["name"]; sess = s["tmux_session"]
groups = s["groups"]; expect = s.get("expect", {}); busy = [str(p) for p in s.get("busy_ports", [])]
keep = [str(p) for p in s.get("keep_listening", [])]; log = s["log"]; after = s.get("after_cmd", "")
if not outp:
    outp = os.path.join(os.path.dirname(os.path.abspath(spec_path)), "stop_%s.sh" % name)
q = shlex.quote
wins = [w for g in groups for w in g]
exp_lines = "\n".join("EXP[%s]=%s" % (q(w), q(expect[w])) for w in wins if w in expect)
garr = "GRP=(%s)" % " ".join(q(" ".join(g)) for g in groups)
sh = r'''#!/usr/bin/env bash
# Generated by cdx-agent --teardown from __SPEC__ . DRY RUN by default.
#   bash __BASE__            # checks only
#   CONFIRM=1 bash __BASE__  # kills windows group by group (tmux kill-window only, never kill-session)
set -uo pipefail
NAME=__NAME__; S=__SESS__; LOG=__LOG__
__GARR__
PORTS=(__PORTS__); KEEP=(__KEEP__)
declare -A EXP
__EXP__
AFTER=__AFTER__
mkdir -p "$(dirname "$LOG")"
ev() { printf '{"t": "%s", "kind": "%s", "text": "%s"}\n' "$(date -Is)" "$1" "$2" >> "$LOG"; }
fail=0; ok() { echo "  ok   $*"; }; bad() { echo "  FAIL $*"; fail=1; }
nconn() { ss -tnH state established "( dport = :$1 )" 2>/dev/null | wc -l; }
echo "== identity: each window runs what we expect"
for g in "${GRP[@]}"; do for w in $g; do
  sc=$(tmux list-windows -t "$S" -F '#W|#{pane_start_command}' 2>/dev/null | awk -F'|' -v w="$w" '$1==w{print $2}')
  [ -z "$sc" ] && { echo "  gone $w (already stopped)"; continue; }
  if [ -n "${EXP[$w]:-}" ]; then
    grep -qF -- "${EXP[$w]}" <<< "$sc" && ok "$w" || bad "$w start command does not contain '${EXP[$w]}'"
  else ok "$w (no expect)"; fi
done; done
echo "== must keep listening"
for p in "${KEEP[@]}"; do ss -ltn | awk '{print $4}' | grep -q ":$p\$" && ok ":$p listening" || bad ":$p not listening"; done
echo "== no connection in flight"
for p in "${PORTS[@]}"; do
  n=$(nconn "$p"); [ "$n" -eq 0 ] && ok "no open conn to :$p" || bad "$n open conn(s) to :$p (episode in flight?)"
done
[ $fail = 0 ] || { echo "ABORT: checks failed; nothing stopped"; exit 1; }
if [ "${CONFIRM:-0}" != 1 ]; then echo "dry run OK (CONFIRM=1 to stop: ${GRP[*]})"; exit 0; fi
ev START "stop $NAME"
first=1
for g in "${GRP[@]}"; do
  for w in $g; do tmux kill-window -t "$S:$w" 2>/dev/null && ev KILL "$w"; done
  sleep 2
  if [ $first = 1 ]; then
    first=0
    for p in "${PORTS[@]}"; do
      n=$(nconn "$p")
      [ "$n" -eq 0 ] || { ev ABORT "open conn :$p after first group"; echo "ABORT: conn on :$p appeared; first group stopped, rest still up"; exit 1; }
    done
  fi
done
[ -n "$AFTER" ] && { bash -c "$AFTER" && ev AFTER "ran after_cmd" || ev AFTER "after_cmd failed"; }
ev DONE "stopped $NAME"
echo "stopped $NAME. Check ports and public endpoints."
'''
rep = {"__SPEC__": spec_path, "__BASE__": os.path.basename(outp), "__NAME__": q(name), "__SESS__": q(sess),
       "__LOG__": q(log), "__GARR__": garr, "__PORTS__": " ".join(busy), "__KEEP__": " ".join(keep),
       "__EXP__": exp_lines, "__AFTER__": q(after)}
for k, v in rep.items():
    sh = sh.replace(k, v)
open(outp, "w").write(sh)
os.chmod(outp, os.stat(outp).st_mode | stat.S_IXUSR | stat.S_IXGRP | stat.S_IXOTH)
print("wrote %s" % outp)
PY
}

case "$MODE" in
  doctor)
    print_doctor
    ;;
  token-doctor)
    print_token_doctor
    ;;
  validate-skills)
    cdx_agent_py validate-skills --repo "$(current_dir)"
    ;;
  skills-list)
    cdx_agent_py skills-list --repo "$(current_dir)"
    ;;
  skills-audit)
    cdx_agent_py skills-audit --repo "$(current_dir)"
    ;;
  init-tools)
    ensure_tools_layout
    ensure_repo_graph_pythonpath
    echo "Initialized or verified local Codex tools under $TOOLS_ROOT"
    echo "repo_graph_pythonpath=$REPO_GRAPH_PYTHONPATH"
    echo "pth_link=$SITE_PTH"
    echo "token_tools_root=$TOKEN_TOOLS_ROOT"
    echo "hooks_root=$HOOKS_ROOT"
    echo "skills_root=$TOOLS_ROOT/skills"
    echo "subagent_prompts_root=$TOOLS_ROOT/subagent_prompts"
    echo "mcp_fragment=$DISABLED_MCP_FRAGMENT"
    ;;
  init-repo)
    run_init_repo
    ;;
  dg)
    cdx_run_dg "dg" "$(guarded_graph_target_dir)" "${PASSTHROUGH[@]}"
    ;;
  graperoot)
    cdx_run_dg "graperoot" "$(guarded_graph_target_dir)" "${PASSTHROUGH[@]}"
    ;;
  dg-root)
    cdx_run_dg "dg-root" "$(cdx_resolve_dg_root "$DG_ROOT_OVERRIDE")" "${PASSTHROUGH[@]}"
    ;;
  graperoot-root)
    cdx_run_dg "graperoot-root" "$(cdx_resolve_dg_root "$DG_ROOT_OVERRIDE")" "${PASSTHROUGH[@]}"
    ;;
  dg-workspace)
    cdx_run_dg_workspace "dg-workspace" "$DG_WORKSPACE_SPEC" "${PASSTHROUGH[@]}"
    ;;
  dg-workspace-init)
    cdx_init_dg_workspace "$DG_WORKSPACE_INIT_NAME" "${DG_WORKSPACE_INIT_PATHS[@]}"
    ;;
  dg-workspace-list)
    cdx_list_dg_workspaces
    ;;
  dg-workspace-show)
    cdx_show_dg_workspace "$DG_WORKSPACE_SPEC"
    ;;
  dg-workspace-clean)
    cdx_clean_dg_workspace "$DG_WORKSPACE_SPEC"
    ;;
  detect-deps)
    run_repo_graph_detect_deps "$(guarded_graph_target_dir)"
    ;;
  init-workspace)
    run_repo_graph_init_workspace "$(guarded_graph_target_dir)"
    ;;
  graph)
    run_graph_only
    ;;
  workspace-graph)
    run_repo_graph_workspace_graph "$(guarded_graph_target_dir)"
    ;;
  workspace-doctor)
    run_repo_graph_workspace_doctor "$(guarded_graph_target_dir)"
    ;;
  session-doctor)
    if [[ "$ACCESS_MODE" == "full" ]]; then
      cdx_agent_py session-doctor --repo "$(current_dir)" --engine "$ENGINE" --full
    else
      cdx_agent_py session-doctor --repo "$(current_dir)" --engine "$ENGINE" --safe
    fi
    ;;
  review)
    review_repo
    ;;
  usage)
    run_usage_daily
    ;;
  usage-session)
    run_usage_session
    ;;
  usage-month)
    run_usage_month
    ;;
  install-token-tools)
    install_token_tools
    ;;
  compress-output)
    run_compress_output
    ;;
  summarize-log)
    run_summarize_log
    ;;
  context-budget)
    run_context_budget
    ;;
  install-hooks)
    cdx_agent_py install-hooks --repo "$(guarded_graph_target_dir)" --engine "$ENGINE"
    ;;
  offload)
    if [[ -n "$TARGET_REPO" ]]; then
      cdx_agent_mod offload --repo "$TARGET_REPO" "${MODULE_ARGS[@]}"
    else
      cdx_agent_mod offload "${MODULE_ARGS[@]}"
    fi
    ;;
  notify)
    cdx_agent_mod notify "${MODULE_ARGS[@]}"
    ;;
  hash-repro)
    run_hash_repro
    ;;
  teardown)
    run_teardown
    ;;
  move-verify)
    cdx_agent_mod move_verify "${MODULE_ARGS[@]}"
    ;;
  hygiene)
    if [[ -n "$TARGET_REPO" ]]; then
      cdx_agent_py hygiene --repo "$TARGET_REPO" "${MODULE_ARGS[@]}"
    else
      cdx_agent_py hygiene "${MODULE_ARGS[@]}"
    fi
    ;;
  coldbank)
    cdx_agent_mod coldbank "${MODULE_ARGS[@]}"
    ;;
  deploy)
    if cdx_is_dry_run; then cdx_agent_mod deploy --dry-run "${MODULE_ARGS[@]}"; else cdx_agent_mod deploy "${MODULE_ARGS[@]}"; fi
    ;;
  value)
    cdx_agent_mod values "${MODULE_ARGS[@]}"
    ;;
  rm)
    if cdx_is_dry_run; then cdx_agent_mod trash rm --dry-run "${MODULE_ARGS[@]}"; else cdx_agent_mod trash rm "${MODULE_ARGS[@]}"; fi
    ;;
  trash)
    cdx_agent_mod trash "${MODULE_ARGS[@]}"
    ;;
  inuse)
    cdx_agent_mod inuse "${MODULE_ARGS[@]}"
    ;;
  cpu-job)
    cdx_agent_mod cpu_job "${MODULE_ARGS[@]}"
    ;;
  watch)
    cdx_agent_mod watch "${MODULE_ARGS[@]}"
    ;;
  agent-usage)
    cdx_agent_mod agent_usage "${MODULE_ARGS[@]}"
    ;;
  gpu-pick)
    CDX_SLURM_HOST="${CDX_SLURM_HOST:-rlab1}" cdx_agent_mod gpu_pick "${MODULE_ARGS[@]}"
    ;;
  handoff)
    if [[ -n "$TARGET_REPO" ]]; then
      CDX_SLURM_HOST="${CDX_SLURM_HOST:-rlab1}" cdx_agent_mod handoff --repo "$TARGET_REPO" "${MODULE_ARGS[@]}"
    else
      CDX_SLURM_HOST="${CDX_SLURM_HOST:-rlab1}" cdx_agent_mod handoff "${MODULE_ARGS[@]}"
    fi
    ;;
  brief)
    if [[ -n "$TARGET_REPO" ]]; then
      cdx_agent_mod brief --rules "$TOOLS_ROOT/base/brief_rules.md" --repo "$TARGET_REPO" "${MODULE_ARGS[@]}"
    else
      cdx_agent_mod brief --rules "$TOOLS_ROOT/base/brief_rules.md" "${MODULE_ARGS[@]}"
    fi
    ;;
  gpu-lock)
    if cdx_is_dry_run; then
      cdx_agent_mod gpu_lock --dry-run "${MODULE_ARGS[@]}"
    else
      cdx_agent_mod gpu_lock "${MODULE_ARGS[@]}"
    fi
    ;;
  launch)
    launch_codex
    ;;
  help)
    print_usage
    ;;
  *)
    echo "Unknown mode: $MODE"
    exit 1
    ;;
esac
